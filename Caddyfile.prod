:80 {
	root * /srv

	handle /up {
		header Content-Type text/plain; charset=utf-8
		respond `OK` 200
	}

	# Markdown for Agents. An agent that asks for markdown gets the markdown
	# rendition of the landing page; browsers send `Accept: text/html` and curl
	# sends `*/*`, so neither matches and HTML stays the default.
	# The rewrite lives inside the `handle` so the matcher is evaluated once,
	# before the path changes — a `header @markdown` placed after a top-level
	# `rewrite @markdown` would re-test the matcher against /index.md and miss.
	# Only `/` has a markdown twin; nothing else needs a rule.
	@markdown {
		path / /index.html
		header Accept *text/markdown*
	}
	handle @markdown {
		rewrite * /index.md
		header Content-Type "text/markdown; charset=utf-8"
		header Vary Accept
		file_server
	}

	handle {
		# RFC 8288 Link headers, homepage only. Agents that never parse the HTML
		# still find the markdown alternate and the sitemap. The values are
		# relative URI-references, resolved against the request URL — that keeps
		# the domain out of this file, so it stays spelled out in four places
		# and not five (see the table in CLAUDE.md).
		@home path / /index.html
		header @home +Link `</>; rel="canonical"`
		header @home +Link `</index.md>; rel="alternate"; type="text/markdown"`
		header @home +Link `</sitemap.xml>; rel="sitemap"; type="application/xml"`
		header @home +Link `<https://github.com/getcolors>; rel="author"`
		# The HTML and the markdown share a URL, so caches have to key on Accept
		# or they will hand an agent's markdown response to a browser.
		header @home Vary Accept

		# Astro emits catalog routes as <path>/index.html. Prefer that file
		# before handing the request to file_server so skills.sh-shaped canonical
		# URLs such as /getcolors/once/package-once-green stay slashless instead
		# of receiving file_server's automatic directory redirect.
		try_files {path}/index.html {path}
		file_server
	}

	handle_errors {
		# Missing machine-discovery documents must remain honest 404s. Redirecting
		# them makes scanners follow the homepage and misreport HTML as malformed
		# API, authentication, or other discovery metadata.
		@missingDiscovery {
			path /.well-known/* /auth.md
			expression `{err.status_code} == 404`
		}
		respond @missingDiscovery `404 Not Found` 404

		# Everything retired from the old site — the blog, /manual, the old
		# top-level package routes and talks — 301s to the landing page, so old
		# inbound links and search results keep working. Discovery paths are
		# excluded so the respond rule above can preserve their 404 status.
		# The matcher must sit on `redir` itself. Wrapping it as
		# `handle @notFound { redir / 301 }` passes `caddy validate` but emits a
		# bare 404 with no Location header at runtime.
		@notFound {
			not path /.well-known/* /auth.md
			expression `{err.status_code} == 404`
		}
		redir @notFound / 301

		@other expression `{err.status_code} != 404`
		respond @other `{err.status_code} {err.status_text}` {err.status_code}
	}
}
