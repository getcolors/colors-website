---
import SeoMeta from "~/components/SeoMeta.astro";
import StyleGate from "~/components/StyleGate.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import SiteHeader from "~/components/SiteHeader.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, path, image, imageAlt } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <SeoMeta title={title} description={description} path={path} {image} {imageAlt} />
    <StyleGate />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4VKP1WY4QJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-4VKP1WY4QJ");
    </script>
  </head>
  <body>
    <SiteHeader active="catalog" />
    <main><slot /></main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/ibm-plex-mono-400-latin.woff2") format("woff2");
  }
  @font-face {
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("/fonts/ibm-plex-mono-500-latin.woff2") format("woff2");
  }
  @font-face {
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("/fonts/ibm-plex-mono-600-latin.woff2") format("woff2");
  }
  @font-face {
    font-family: "IBM Plex Sans";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/ibm-plex-sans-400-latin.woff2") format("woff2");
  }
  @font-face {
    font-family: "IBM Plex Sans";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("/fonts/ibm-plex-sans-400-latin.woff2") format("woff2");
  }
  @font-face {
    font-family: "IBM Plex Sans";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("/fonts/ibm-plex-sans-400-latin.woff2") format("woff2");
  }
  @font-face {
    font-family: "IBM Plex Sans";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url("/fonts/ibm-plex-sans-400-latin.woff2") format("woff2");
  }
  :root {
    --ink: oklch(20% 0.01 260);
    --code-ink: oklch(35% 0.01 260);
    --muted: oklch(45% 0.01 260);
    --soft: oklch(55% 0.01 260);
    --faint: var(--soft);
    --line: oklch(91% 0.005 260);
    --rule: oklch(92% 0.005 260);
    --page: oklch(99% 0.002 90);
    --surface: oklch(97.5% 0.003 260);
    --panel: oklch(97% 0.005 260);
    --on-dark: oklch(96% 0.005 260);
    --red: oklch(60% 0.19 25);
    --green: oklch(65% 0.17 145);
    --blue: oklch(55% 0.18 260);
    --mono: "IBM Plex Mono", monospace;
    --sans: "IBM Plex Sans", Helvetica, Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--page); color: var(--ink); font-family: var(--sans); line-height: 1.5; }
  a { color: var(--blue); text-decoration: none; }
  a:hover { color: oklch(45% 0.18 260); }
  button, input { font: inherit; }
  .wrap { width: min(1072px, calc(100% - 48px)); margin-inline: auto; }
  .eyebrow, .section-label { margin: 0 0 10px; color: var(--soft); font: 400 12px/1.5 var(--mono); text-transform: uppercase; }
  .section-label { color: var(--blue); }
  h1 { margin: 0 0 20px; font-size: 52px; font-weight: 600; line-height: 1.08; letter-spacing: -.02em; }
  h2 { font-size: 28px; font-weight: 600; line-height: 1.15; letter-spacing: -.01em; }
  h3 { font-weight: 600; line-height: 1.2; letter-spacing: -.01em; }
  .lede { max-width: 680px; color: var(--muted); font-size: 18px; }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; color: var(--faint); font: 13px var(--sans); }
  .breadcrumb a:hover { color: var(--blue); }
  .panel { border: 1px solid var(--line); border-radius: 12px; background: var(--page); }
  .runtime { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border: 1px solid var(--line); border-radius: 999px; font: 12px var(--mono); }
  .runtime::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--runtime-color, var(--blue)); }
  .runtime-red { --runtime-color: var(--red); }
  .runtime-green { --runtime-color: var(--green); }
  .runtime-blue { --runtime-color: var(--blue); }
  .mono { font-family: var(--mono); }
  .muted { color: var(--muted); }
  .button-link { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 9px 14px; border: 1px solid var(--line); border-radius: 8px; color: var(--blue); font: 13px var(--mono); }
  .button-link:hover { border-color: var(--blue); background: oklch(97% 0.015 260); }
  :focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  @media (max-width: 860px) {
    h1 { font-size: 38px; }
  }

</style>
