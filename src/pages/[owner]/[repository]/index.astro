---
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import ContextSkillList from "~/components/ContextSkillList.astro";
import InstallBox from "~/components/InstallBox.astro";
import PackageSkillList from "~/components/PackageSkillList.astro";
import CatalogLayout from "~/layouts/CatalogLayout.astro";
import { catalogOgImage, formatInstalls, loadCatalog, type CatalogRepository } from "~/data/catalog";

// Routes come from repositories, not recipes: several recipes may share one
// repository (Context Skills all live in getcolors/skills), and this path
// exists once per repository.
export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.repositories.map((repository) => ({
    params: { owner: repository.owner, repository: repository.repositoryName },
    props: {
      repository,
      // The companion link renders in both directions: a Context Skill names
      // this repository as its tested implementation, and this page links back.
      companionContextSkills: catalog.contextSkills.filter((skill) => skill.companion === repository.repository),
    },
  }));
}
interface Props { repository: CatalogRepository; companionContextSkills: import("~/data/catalog").ContextSkill[]; }
const { repository, companionContextSkills } = Astro.props;
const single = repository.recipes.length === 1 ? repository.recipes[0] : undefined;
const packageCount = repository.packageSkills.length;
const contextCount = repository.contextSkills.length;
const skillNoun =
  packageCount > 0 && contextCount > 0 ? "Skills" : contextCount > 0 ? "Context Skills" : "Package Skills";
const title = `${repository.repository} ${skillNoun} — Colors`;
const description = single
  ? `${single.summary} Browse ${packageCount + contextCount} ${skillNoun} and load them with npx skills.`
  : `Browse ${packageCount + contextCount} curated skills from ${repository.repository}.`;
// A repo-level install command only exists for Package Skills; a context
// skill is loaded per-skill with npx skills use, shown when it is alone here.
const soleContextSkill = packageCount === 0 && contextCount === 1 ? repository.contextSkills[0] : undefined;
const command = soleContextSkill ? soleContextSkill.installCommand : `npx skills add ${repository.repository}`;
const prompt = soleContextSkill
  ? soleContextSkill.prompt
  : `Run \`npx skills use "https://github.com/${repository.repository}"\` and follow the generated Package Skill instructions now.`;
const showInstall = packageCount > 0 || soleContextSkill !== undefined;
---
<CatalogLayout {title} {description} path={repository.url} image={catalogOgImage("source", repository.owner, repository.repositoryName)} imageAlt={`${single ? single.name : repository.repository} on Colors`}>
  <section class="source-page wrap">
    <Breadcrumbs items={[{ label: "Catalog", href: "/skills" }, { label: repository.owner, href: `/${repository.owner}` }, { label: repository.repositoryName }]} />
    <div class="source-head">
      <div><h1>{repository.repository}</h1></div>
    </div>
    {single && <p class="lede">{single.summary}</p>}
    <div class="source-meta">
      <div class="stats">
        {packageCount > 0 && (
          <span>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Z"/><path d="m4 12 8 4.5 8-4.5M4 16.5l8 4.5 8-4.5"/></svg>
            <strong>{packageCount}</strong> {packageCount === 1 ? "Package Skill" : "Package Skills"}
          </span>
        )}
        {contextCount > 0 && (
          <span>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
            <strong>{contextCount}</strong> {contextCount === 1 ? "Context Skill" : "Context Skills"}
          </span>
        )}
        <span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19V9M12 19V4M19 19v-7M3 19h18"/></svg>
          <strong>{formatInstalls(repository.installs)}</strong> total installs
        </span>
      </div>
      <div class="source-actions">
        {companionContextSkills.map((skill) => (
          <a class="featured-link" href={skill.url} title={`Context Skill: ${skill.name}`}>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
            <span>Context Skill</span>
          </a>
        ))}
        {single?.featured && (
          <a class="featured-link" href={single.featured}>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 3 2.75 5.57 6.15.9-4.45 4.33 1.05 6.12L12 17.03l-5.5 2.89 1.05-6.12L3.1 9.47l6.15-.9L12 3Z"/></svg>
            <span>Featured</span>
          </a>
        )}
        <a class="github-link" href={repository.githubUrl} target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>
    {showInstall && (
      <section class="installation" aria-label="Installation">
        <InstallBox {command} {prompt} rewrite={soleContextSkill === undefined} />
      </section>
    )}
    {single ? (
      <>
        {single.packageSkills.length > 0 && <PackageSkillList packageSkills={single.packageSkills} />}
        {single.contextSkills.length > 0 && <ContextSkillList contextSkills={single.contextSkills} />}
      </>
    ) : (
      repository.recipes.map((recipe) => (
        <section class="recipe-block">
          <h2>{recipe.name}</h2>
          <p class="recipe-summary">{recipe.summary}</p>
          {recipe.packageSkills.length > 0 && <PackageSkillList packageSkills={recipe.packageSkills} />}
          {recipe.contextSkills.length > 0 && <ContextSkillList contextSkills={recipe.contextSkills} />}
        </section>
      ))
    )}
  </section>
</CatalogLayout>
<style>
  .source-page { padding-block: 62px 80px; }
  .source-head { display: flex; align-items: end; justify-content: space-between; gap: 25px; }
  h1 { overflow-wrap: anywhere; }
  .source-meta { display: flex; align-items: center; gap: 24px; margin: 34px 0 55px; }
  .stats { display: flex; flex-wrap: wrap; gap: 14px 28px; color: var(--muted); font-size: 14px; }
  .stats span { display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
  .stats svg { width: 18px; height: 18px; fill: none; stroke: var(--blue); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .stats strong { color: var(--ink); font-size: 14px; font-weight: 600; }
  .installation { width: 100%; margin-bottom: 48px; }
  .source-actions { display: flex; align-items: center; gap: 18px; }
  .featured-link { display: inline-flex; align-items: center; gap: 7px; color: var(--blue); font-size: 14px; white-space: nowrap; }
  .featured-link svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linejoin: round; }
  .github-link { display: inline-flex; align-items: center; gap: 7px; color: var(--blue); font-size: 14px; white-space: nowrap; }
  .github-link svg { width: 17px; height: 17px; }
  .recipe-block { margin-bottom: 48px; }
  .recipe-block h2 { margin: 0 0 10px; font-size: 24px; }
  .recipe-summary { margin: 0 0 20px; color: var(--muted); }
  @media (max-width: 700px) {
    .source-meta { align-items: flex-start; flex-direction: column; }
    .source-actions { margin-left: 0; }
  }
</style>
