---
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import CatalogLayout from "~/layouts/CatalogLayout.astro";
import { catalogOgImage, formatInstalls, loadCatalog, type CatalogOwner } from "~/data/catalog";

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.owners.map((owner) => ({ params: { owner: owner.name }, props: { owner } }));
}
interface Props { owner: CatalogOwner; }
const { owner } = Astro.props;
const title = `${owner.name} Package Skills — Colors`;
const skillTotal = owner.packageSkills.length + owner.contextSkills.length;
const description = `Browse ${skillTotal} curated skills from ${owner.name} in the Colors Skills Catalog.`;
---
<CatalogLayout {title} {description} path={owner.url} image={catalogOgImage("owner", owner.name)} imageAlt={`${owner.name} Package Skills on Colors`}>
  <section class="owner-page wrap">
    <Breadcrumbs items={[{ label: "Catalog", href: "/skills" }, { label: owner.name }]} />
    <div class="owner-head">
      <div><h1>{owner.name}</h1></div>
    </div>
    <div class="stats">
      <span>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h14v6H5zM5 14h14v6H5z"/><path d="M8 7h.01M8 17h.01"/></svg>
        <strong>{owner.repositories.length}</strong> sources
      </span>
      <span>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Z"/><path d="m4 12 8 4.5 8-4.5M4 16.5l8 4.5 8-4.5"/></svg>
        <strong>{owner.packageSkills.length}</strong> Package Skills
      </span>
      {owner.contextSkills.length > 0 && (
        <span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
          <strong>{owner.contextSkills.length}</strong> {owner.contextSkills.length === 1 ? "Context Skill" : "Context Skills"}
        </span>
      )}
      <span>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19V9M12 19V4M19 19v-7M3 19h18"/></svg>
        <strong>{formatInstalls(owner.installs)}</strong> total installs
      </span>
      <a class="github-link" href={owner.githubUrl} target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
        <span>GitHub</span>
      </a>
    </div>
    <div class="source-list panel">
      <div class="list-head"><span>Source</span><span>Installs</span></div>
      {owner.repositories.map((repository) => {
        const skills = [...repository.packageSkills, ...repository.contextSkills];
        const noun = repository.packageSkills.length === 0
          ? (skills.length === 1 ? "Context Skill" : "Context Skills")
          : (skills.length === 1 ? "Package Skill" : "Package Skills");
        return (
          <a class="source-row" href={repository.url}>
            <div><strong>{repository.repositoryName}</strong><p>{skills.length} {noun}: {skills.slice(0, 3).map((item) => item.name).join(", ")}{skills.length > 3 && ` +${skills.length - 3} more`}</p></div>
            <span>{formatInstalls(repository.installs)}</span>
          </a>
        );
      })}
    </div>
  </section>
</CatalogLayout>
<style>
  .owner-page { padding-block: 62px 80px; }
  .owner-head { display: flex; align-items: end; justify-content: space-between; gap: 25px; }
  .stats { display: flex; flex-wrap: wrap; gap: 14px 32px; margin: 35px 0 55px; color: var(--muted); font-size: 14px; }
  .stats span { display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
  .stats svg { width: 18px; height: 18px; fill: none; stroke: var(--blue); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .stats strong { color: var(--ink); font-size: 14px; font-weight: 600; }
  .stats .github-link { display: inline-flex; align-items: center; gap: 7px; color: var(--blue); white-space: nowrap; }
  .list-head, .source-row { display: grid; grid-template-columns: 1fr 100px; gap: 20px; padding: 15px 20px; }
  .list-head { color: var(--faint); font: 11px var(--mono); text-transform: uppercase; }
  .list-head span:last-child { text-align: right; }
  .source-row { align-items: center; border-top: 1px solid var(--line); }
  .source-row:hover { background: var(--surface); }
  .source-row strong { color: var(--ink); font: 500 17px var(--sans); }
  .source-row p { margin: 4px 0 0; color: var(--muted); font-size: 13px; }
  .source-row > span { color: var(--muted); font: 13px var(--mono); text-align: right; }
</style>
