---
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import CatalogLayout from "~/layouts/CatalogLayout.astro";
import { catalogOgImage, formatInstalls, loadCatalog, runtimeLabels, type CatalogOwner, type Runtime } from "~/data/catalog";

export async function getStaticPaths() {
  const catalog = await loadCatalog();
  return catalog.owners.map((owner) => ({ params: { owner: owner.name }, props: { owner } }));
}
interface Props { owner: CatalogOwner; }
const { owner }: Props = Astro.props;
const title = `${owner.name} Package Skills — Colors`;
const skillTotal = owner.packageSkills.length + owner.contextSkills.length;
const description = `Browse ${skillTotal} curated skills from ${owner.name} in the Colors Skills Catalog.`;
const hasBothKinds = owner.packageSkills.length > 0 && owner.contextSkills.length > 0;
type OwnerRepository = CatalogOwner["repositories"][number];
// Rows are searched by everything a visitor might scan for: the repository,
// the recipes' product names and keywords, skill names, runtimes, and kinds.
const rowSearch = (repository: OwnerRepository) =>
  [
    repository.repository,
    repository.repositoryName,
    ...repository.recipes.flatMap((recipe) => [recipe.name, ...recipe.keywords]),
    ...repository.packageSkills.flatMap((item) => [item.name, item.runtime, runtimeLabels[item.runtime]]),
    ...repository.contextSkills.map((item) => item.name),
    repository.contextSkills.length > 0 ? "context skill" : "",
  ].join(" ").toLowerCase();
const rowKinds = (repository: OwnerRepository) =>
  [repository.packageSkills.length > 0 && "package", repository.contextSkills.length > 0 && "context"]
    .filter(Boolean)
    .join(" ");
const rowRuntimes = (repository: OwnerRepository) =>
  [...new Set(repository.packageSkills.map((item) => item.runtime))] as Runtime[];
const rowKeywords = (repository: OwnerRepository) =>
  [...new Set(repository.recipes.flatMap((recipe) => recipe.keywords))].slice(0, 6);
---
<CatalogLayout {title} {description} path={owner.url} image={catalogOgImage("owner", owner.name)} imageAlt={`${owner.name} Package Skills on Colors`}>
  <section class="owner-page wrap">
    <Breadcrumbs items={[{ label: "Catalog", href: "/skills" }, { label: owner.name }]} />
    <div class="owner-head">
      <div><h1>{owner.name}</h1></div>
    </div>
    <div class="stats">
      <span>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h14v6H5zM5 14h14v6H5z"/><path d="M8 7h.01M8 17h.01"/></svg>
        <strong>{owner.repositories.length}</strong> sources
      </span>
      <span>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Z"/><path d="m4 12 8 4.5 8-4.5M4 16.5l8 4.5 8-4.5"/></svg>
        <strong>{owner.packageSkills.length}</strong> Package Skills
      </span>
      {owner.contextSkills.length > 0 && (
        <span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
          <strong>{owner.contextSkills.length}</strong> {owner.contextSkills.length === 1 ? "Context Skill" : "Context Skills"}
        </span>
      )}
      <span>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19V9M12 19V4M19 19v-7M3 19h18"/></svg>
        <strong>{formatInstalls(owner.installs)}</strong> total installs
      </span>
      <a class="github-link" href={owner.githubUrl} target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" stroke="none" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
        <span>GitHub</span>
      </a>
    </div>
    <div class="finder">
      <label class="search">
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 5 5"></path></svg>
        <span class="sr-only">Filter sources</span>
        <input id="owner-search" type="search" placeholder="Filter by platform, provider, runtime, keyword…" autocomplete="off" />
        <kbd>/</kbd>
      </label>
      {hasBothKinds && (
        <div class="catalog-tabs" role="tablist" aria-label="Skill kind">
          <button type="button" role="tab" aria-selected="true" data-owner-tab="all">All</button>
          <button type="button" role="tab" aria-selected="false" data-owner-tab="package">Package Skills</button>
          <button type="button" role="tab" aria-selected="false" data-owner-tab="context">Context Skills</button>
        </div>
      )}
    </div>
    <div class="source-list panel">
      <div class="list-head"><span>Source</span><span>Installs</span></div>
      {owner.repositories.map((repository) => {
        const skills = [...repository.packageSkills, ...repository.contextSkills];
        const noun = repository.packageSkills.length === 0
          ? (skills.length === 1 ? "Context Skill" : "Context Skills")
          : (skills.length === 1 ? "Package Skill" : "Package Skills");
        return (
          <a class="source-row" href={repository.url} data-search={rowSearch(repository)} data-kinds={rowKinds(repository)}>
            <div>
              <span class="row-title">
                <strong>{repository.repositoryName}</strong>
                {rowRuntimes(repository).map((runtime) => (
                  <span class:list={["runtime", `runtime-${runtime}`]} title={runtimeLabels[runtime]}>{runtime}</span>
                ))}
                {repository.contextSkills.length > 0 && <span class="runtime runtime-context">context</span>}
              </span>
              <p>{skills.length} {noun} · {rowKeywords(repository).join(" · ")}</p>
            </div>
            <span class="installs">{formatInstalls(repository.installs)}</span>
          </a>
        );
      })}
      <p id="owner-empty" class="empty" hidden>No sources match that filter.</p>
    </div>
  </section>
</CatalogLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("#owner-search");
  const rows = [...document.querySelectorAll<HTMLElement>(".source-row[data-search]")];
  const empty = document.querySelector<HTMLElement>("#owner-empty");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-owner-tab]")];
  let active = "all";
  const filter = () => {
    const terms = (input?.value ?? "").toLowerCase().trim().split(/\s+/).filter(Boolean);
    let visibleCount = 0;
    for (const row of rows) {
      const kindOk = active === "all" || (row.dataset.kinds ?? "").split(" ").includes(active);
      const visible = kindOk && terms.every((term) => row.dataset.search?.includes(term));
      row.hidden = !visible;
      if (visible) visibleCount += 1;
    }
    if (empty) empty.hidden = visibleCount !== 0;
  };
  const select = (tab: string) => {
    active = tab;
    tabs.forEach((button) => button.setAttribute("aria-selected", String(button.dataset.ownerTab === tab)));
    filter();
  };
  tabs.forEach((button) => button.addEventListener("click", () => select(button.dataset.ownerTab ?? "all")));
  input?.addEventListener("input", filter);
  document.addEventListener("keydown", (event) => {
    if (event.key === "/" && document.activeElement !== input) {
      event.preventDefault();
      input?.focus();
    }
  });
</script>

<style>
  .owner-page { padding-block: 62px 80px; }
  .owner-head { display: flex; align-items: end; justify-content: space-between; gap: 25px; }
  .stats { display: flex; flex-wrap: wrap; gap: 14px 32px; margin: 35px 0 30px; color: var(--muted); font-size: 14px; }
  .stats span { display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
  .stats svg { width: 18px; height: 18px; fill: none; stroke: var(--blue); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .stats strong { color: var(--ink); font-size: 14px; font-weight: 600; }
  .stats .github-link { display: inline-flex; align-items: center; gap: 7px; color: var(--blue); white-space: nowrap; }
  .finder { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px; margin-bottom: 26px; }
  .search { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px; flex: 1 1 320px; max-width: 520px; padding: 11px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); }
  .search:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px oklch(55% .18 260 / .12); }
  .search svg { width: 18px; fill: none; stroke: var(--muted); stroke-width: 1.7; }
  .search input { min-width: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font-size: 15px; }
  .search kbd { padding: 2px 7px; border: 1px solid var(--line); border-radius: 5px; color: var(--faint); font: 12px var(--mono); }
  .catalog-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .catalog-tabs button { padding: 8px 16px; border: 1px solid var(--line); border-radius: 100px; background: var(--panel); color: var(--muted); font: 13px var(--sans); cursor: pointer; transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease; }
  .catalog-tabs button:hover { border-color: oklch(80% 0.04 260); color: var(--ink); }
  .catalog-tabs button[aria-selected="true"] { border-color: var(--blue); background: oklch(96% 0.03 260); color: var(--blue); }
  .list-head, .source-row { display: grid; grid-template-columns: 1fr 100px; gap: 20px; padding: 15px 20px; }
  .list-head { color: var(--faint); font: 11px var(--mono); text-transform: uppercase; }
  .list-head span:last-child { text-align: right; }
  .source-row { align-items: center; border-top: 1px solid var(--line); }
  .source-row[hidden] { display: none; }
  .source-row:hover { background: var(--surface); }
  .row-title { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .source-row strong { color: var(--ink); font: 500 17px var(--sans); }
  .source-row p { margin: 4px 0 0; color: var(--muted); font-size: 13px; }
  .source-row .installs { color: var(--muted); font: 13px var(--mono); text-align: right; }
  .empty { padding: 40px 20px; color: var(--muted); text-align: center; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  /* flex-basis must reset with the axis flip: .search's 320px basis means
     width in the row layout, but height once .finder is a column. */
  @media (max-width: 700px) { .finder { align-items: stretch; flex-direction: column; } .search { max-width: none; flex-basis: auto; } }
</style>
