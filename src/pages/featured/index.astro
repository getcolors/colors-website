  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <SeoMeta title={title} description={description} path="/featured" image="/og-featured-blue-v1.png" imageAlt="Featured Package Skills built with Colors" />
    <StyleGate />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
