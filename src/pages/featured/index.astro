---
import InstallBox from "~/components/InstallBox.astro";
import ResourceLinks from "~/components/ResourceLinks.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import SeoMeta from "~/components/SeoMeta.astro";
import StyleGate from "~/components/StyleGate.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import {
  airflow,
  airflowInstallCmd,
  clickhouse,
  clickhouseInstallCmd,
  posthog,
  posthogInstallCmd,
  rybbit,
  rybbitInstallCmd,
  umami,
  umamiInstallCmd,
  dbos,
  dbosInstallCmd,
  html,
  installCmd,
  k8s,
  k8sInstallCmd,
  k3s,
  k3sInstallCmd,
  once,
  rama,
  ramaInstallCmd,
  postgresAgy,
  postgresAgyInstallCmd,
  mysqlAgy,
  mysqlAgyInstallCmd,
  postgresHa,
  postgresHaInstallCmd,
  mysqlHa,
  mysqlHaInstallCmd,
  temporal,
  temporalInstallCmd,
  restate,
  restateInstallCmd,
  vaultwarden,
  vaultwardenInstallCmd,
  walter,
  walterInstallCmd,
  wavehouse,
  wavehouseInstallCmd,
  githubDwh,
  githubDwhInstallCmd,
  clickstack,
  clickstackInstallCmd,
  signoz,
  signozInstallCmd,
  netbird,
  netbirdInstallCmd,
  agentNetwork,
  agentNetworkInstallCmd,
  agentNetworkK8s,
  agentNetworkK8sInstallCmd,
} from "~/data/landing";

const title = "Featured — Colors";
const description = "A curated showcase of production infrastructure and platform automation built with the Colors SDK.";
const featuredPackageSkills = [
  { label: "K8s", href: "#k8s" },
  { label: "K3s", href: "#k3s" },
  { label: "Umami", href: "#umami" },
  { label: "Rybbit", href: "#rybbit" },
  { label: "PostHog", href: "#posthog" },
  { label: "ClickHouse", href: "#clickhouse" },
  { label: "Airflow", href: "#airflow" },
  { label: "Rama", href: "#rama" },
  { label: "Once", href: "#once" },
  { label: "Vaultwarden", href: "#vaultwarden" },
  { label: "DBOS", href: "#dbos" },
  { label: "Walter", href: "#walter" },
  { label: "Restate", href: "#restate" },
  { label: "Temporal", href: "#temporal" },
  { label: "PostgreSQL HA", href: "#postgres-agy" },
  { label: "MySQL HA", href: "#mysql-agy" },
  { label: "PostgreSQL HA (Opus 5)", href: "#postgres-ha" },
  { label: "MySQL HA (Opus 5)", href: "#mysql-ha" },
  { label: "WaveHouse", href: "#wavehouse" },
  { label: "GitHub DWH", href: "#github-dwh" },
  { label: "ClickStack", href: "#clickstack" },
  { label: "SigNoz", href: "#signoz" },
  { label: "NetBird", href: "#netbird" },
  { label: "Agent Network", href: "#agent-network" },
  { label: "Agent Network K8s", href: "#agent-network-k8s" },
];
const step = (i: number) => `Step ${String(i + 1).padStart(2, "0")}`;
---

