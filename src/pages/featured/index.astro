        src: url("/fonts/ibm-plex-sans-400-vietnamese.woff2") format('woff2');
        unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;
      }
      /* latin-ext */
      @font-face {
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 700;
        font-stretch: 100%;
        font-display: swap;
        src: url("/fonts/ibm-plex-sans-400-latin-ext.woff2") format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      /* latin */
      @font-face {
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 700;
        font-stretch: 100%;
        font-display: swap;
        src: url("/fonts/ibm-plex-sans-400-latin.woff2") format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      /* The palette the design export expressed as a literal oklch() on every
         element it touched. Named here once so a hue change is one edit, and
         so the three library accents are declared next to each other rather
         than inferred from repetition. */
      :root {
        --ink: oklch(20% 0.01 260);
        --code-ink: oklch(35% 0.01 260);
        --muted: oklch(45% 0.01 260);
        --soft: oklch(55% 0.01 260);
        --line: oklch(91% 0.005 260);
        --rule: oklch(92% 0.005 260);
        --page: oklch(99% 0.002 90);
        --surface: oklch(97.5% 0.003 260);
        --panel: oklch(97% 0.005 260);
        --on-dark: oklch(96% 0.005 260);
        --red: oklch(60% 0.19 25);
        --green: oklch(65% 0.17 145);
        --blue: oklch(55% 0.18 260);
        --mono: 'IBM Plex Mono', monospace;
      }

      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--page); font-family: 'IBM Plex Sans', Helvetica, Arial, sans-serif; }
      a { color: var(--blue); text-decoration: none; }
      a:hover { color: oklch(45% 0.18 260); }
      * { box-sizing: border-box; }

      .page { color: var(--ink); line-height: 1.5; }
      .wrap { max-width: 1072px; margin: 0 auto; }

      /* Section labels. The copy is stored title-case in src/data/landing.ts
         so the markdown twin reads naturally; the caps are presentational. */
      .eyebrow {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--soft);
        margin-bottom: 10px;
        text-transform: uppercase;
      }
      .eyebrow-blue { color: var(--blue); }
      .eyebrow-red { color: var(--red); }
      /* Green-only Package Skills key their section labels to that accent. */
      .eyebrow-green { color: var(--green); }

      /* HERO */
      .hero {
        max-width: 1120px;
        margin: 0 auto;
        padding: 64px 24px 88px;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 56px;
        align-items: center;
      }
      .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--blue);
        background: oklch(96% 0.03 260);
        border: 1px solid oklch(90% 0.05 260);
        padding: 6px 12px;
        border-radius: 100px;
        margin-bottom: 24px;
        text-transform: uppercase;
      }
      h1 { font-size: 52px; line-height: 1.08; letter-spacing: -0.02em; font-weight: 600; margin: 0 0 20px; }
      .hero-lede { font-size: 18px; color: var(--muted); margin: 0 0 32px; max-width: 520px; }

      .install { display: flex; flex-direction: column; gap: 12px; max-width: 480px; }
      .install-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--ink);
        border-radius: 8px;
        padding: 14px 16px;
      }
      /* The CTA repeat shrink-wraps its content instead of filling a column. */
      .install-row-inline {
        display: inline-flex;
        justify-content: flex-start;
        gap: 10px;
        padding: 14px 20px;
        margin: 0 auto;
      }
      .install-row code { font-family: var(--mono); font-size: 14px; color: var(--on-dark); }
      .copy {
        background: oklch(30% 0.01 260);
        color: var(--on-dark);
        border: none;
        border-radius: 6px;
        padding: 6px 12px;
        font-size: 12px;
        font-family: var(--mono);
        cursor: pointer;
      }
      .copy:hover { background: oklch(35% 0.01 260); }
      .install-note { font-size: 13px; color: var(--soft); }

      .yml {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 28px;
        font-family: var(--mono);
        font-size: 13px;
        color: var(--code-ink);
      }
      .yml-caption { color: var(--soft); margin-bottom: 14px; font-size: 12px; }

      /* SECTIONS */
      .sec { border-top: 1px solid var(--rule); padding: 72px 24px; }
      .featured-intro { padding-top: 64px; border-top: 0; }
      /* The index sits under the title rather than beside it. Side by side, a
         204px copy block stood next to a 719px panel and left ~515px of empty
         left column; stacked, the same content is shorter overall and the hole
         is gone. The <nav> already followed the copy in the DOM and the old
         860px breakpoint already stacked them, so this only makes the desktop
         layout agree with the reading order both already had. */
      .featured-intro > .wrap { display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; }
      /* Pill, title, lede read straight down; the lede keeps .sec-lede-wide's
         680px measure so it does not stretch across the full 1072px wrap. */
      .featured-intro-copy .sec-lede { margin-bottom: 0; }
      /* No panel fill or border at full width: at 559px the tint read as a
         card, but stretched across the 1072px wrap it becomes a box wrapping
         the page's whole upper half, with the white tiles nested inside it. A
         hairline under the label does the same job with one less layer. */
      .featured-toc-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--rule); }
      .featured-toc-title { margin: 0; color: var(--ink); font-size: 15px; font-weight: 600; }
      /* Four tracks max. The widest label, "PostgreSQL HA (Opus 5)", needs
         220px of tile (152 label + 12 arrow + 9 gap + 24 padding); the 1072px
         wrap gives 262px at four columns and only 208px at five, so five
         truncates it. Below 1100px the wrap shrinks past that margin, hence
         the step down to three. */
      .featured-toc-links { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
      .featured-toc a { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 9px; min-width: 0; padding: 11px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--page); color: var(--ink); font-size: 14px; transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease; }
      .featured-toc a:hover { border-color: oklch(80% 0.04 260); background: oklch(97% 0.015 260); color: var(--blue); }
      .featured-toc-arrow { color: var(--blue); }
      /* 23 skills over four tracks leave one empty cell in the last row. The
         catalog link fills it, which also gives the count a home -- it used to
         sit in the header as "23 Package Skills" and say nothing actionable. */
      .featured-toc-links a.featured-toc-all { border-style: dashed; background: var(--surface); color: var(--muted); }
      .featured-toc-links a.featured-toc-all:hover { border-style: solid; background: var(--page); color: var(--blue); }
      .sec-alt { background: var(--surface); }
      .sec h2 { font-size: 28px; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 12px; }
      /* A heading with no lede under it carries the lede's bottom margin. */
      .sec h2.solo { margin-bottom: 40px; }
      .sec-lede { font-size: 16px; color: var(--muted); margin: 0 0 40px; max-width: 640px; }
      .sec-lede-wide { max-width: 680px; }
      .definition p { max-width: 900px; margin: 0; color: var(--muted); font-size: 16px; }

      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
      .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
      .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
      /* K3s and Walter each have five steps. Their own class rather than a
         wider .grid-4, because .grid-4 lays out the four Once steps and they
         must keep their width. Five tracks in the same 1120px wrap give a
         narrower card, so keep these bodies short. */
      .grid-5 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-bottom: 48px; }

      /* Cards — the browser/package pair. */
      .card { border: 1px solid var(--line); border-radius: 12px; padding: 28px; }
      .card h3 { font-size: 19px; font-weight: 600; margin: 0 0 10px; }
      .card p { font-size: 15px; color: var(--muted); margin: 0; }
      .card-accent { border-color: oklch(85% 0.06 260); background: oklch(97% 0.02 260); }
      .card-accent p { color: oklch(40% 0.01 260); }

      /* Cards — what a Package Skill bundles. */
      .bundle { background: var(--page); border: 1px solid var(--line); border-radius: 12px; padding: 24px; }
      .bundle .eyebrow { margin-bottom: 12px; }
      .bundle h3 { font-size: 17px; font-weight: 600; margin: 0 0 8px; }
      .bundle p { font-size: 14px; color: var(--muted); margin: 0; }

      /* Cards — the three libraries. */
      .lib {
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 24px;
        color: inherit;
      }
      .lib:hover { border-color: oklch(80% 0.01 260); }
      .lib-swatch { width: 32px; height: 32px; border-radius: 8px; margin-bottom: 16px; }
      .lib h3 { font-size: 17px; font-weight: 600; margin: 0 0 4px; font-family: var(--mono); }
      .lib-stack { font-size: 13px; color: var(--soft); margin-bottom: 12px; }
      .lib p { font-size: 14px; color: var(--muted); margin: 0 0 12px; }

      /* Cards — the four Once steps. */
      .step { border: 1px solid var(--line); border-radius: 10px; padding: 20px; background: var(--page); }
      .step .eyebrow { font-size: 11px; margin-bottom: 8px; }
      .step h4 { font-size: 15px; font-weight: 600; margin: 0 0 6px; }
      .step p { font-size: 13px; color: var(--muted); margin: 0; }

      /* DAG */
      .dag-panel { border: 1px solid var(--line); border-radius: 12px; padding: 36px; background: var(--page); }
      .dag-caption { font-family: var(--mono); font-size: 12px; color: var(--soft); margin-bottom: 24px; }
      .dag { display: flex; align-items: center; gap: 0; flex-wrap: wrap; font-family: var(--mono); font-size: 13px; }
      .dag-node { background: white; border: 1px solid oklch(85% 0.005 260); padding: 10px 16px; border-radius: 8px; }
      /* No border, matching the export — it sits 2px shorter than its
         neighbours and align-items:center absorbs the difference. */
      .dag-start { background: var(--ink); color: white; border: none; }
      .dag-edge { width: 32px; height: 1px; background: oklch(80% 0.005 260); }
      .dag-group { display: flex; flex-direction: column; gap: 8px; }
      .dag-branch { display: grid; grid-template-columns: auto auto; gap: 8px 0; align-items: center; }
      .dag-tail { display: flex; align-items: center; }
      .dag-note { font-size: 13px; color: var(--muted); margin: 20px 0 0; }
      /* Long graphs keep their desktop flow on one line and scroll only the
         diagram, not the panel. */
      @media (min-width: 861px) {
        .wide-dag {
          flex-wrap: nowrap;
          overflow-x: auto;
          padding-bottom: 8px;
        }
        .wide-dag > * { flex: none; }
      }
      /* Walter shows two panels — create/build, then the power pair — and the
         power panel holds two graphs under one caption. */
      .dag-panel + .dag-panel { margin-top: 20px; }
      .dag + .dag { margin-top: 16px; }
      .sec-install { margin: 0 0 40px; }
      .sec-install .install-note { display: block; margin: 10px 0 0; }

      /* CTA */
      .cta { border-top: 1px solid var(--rule); padding: 80px 24px; text-align: center; }
      .cta-inner { max-width: 640px; margin: 0 auto; }
      .cta h2 { font-size: 30px; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 16px; }
      .cta p { font-size: 16px; color: var(--muted); margin: 0 0 32px; }
      .catalog-link { display: inline-flex; align-items: center; gap: 8px; padding: 14px 20px; border-radius: 8px; background: var(--ink); color: var(--on-dark); font: 13px var(--mono); }
      .catalog-link svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .catalog-link:hover { background: oklch(30% 0.01 260); color: white; }

      /* Shiki emits <pre><code>, and both pick up the UA monospace family
         rather than inheriting the panel's. Reapply it, or the hero's YAML
         stops matching every other block of code on the page. */
      .astro-code,
      .astro-code code {
        font-family: var(--mono);
        font-size: 13px;
      }

      /* Responsive collapse. The export ships no media queries; these rules
         only take effect below 860px and leave the desktop design untouched.
         They no longer need !important — the declarations they override are
         now in this stylesheet rather than in style attributes, so ordinary
         cascade order settles it. Keep these blocks last. */
      /* 4 -> 3 -> 2 -> 1. Ordered narrowest-last: these queries have equal
         specificity, so where two match the later block settles it. */
      @media (max-width: 1100px) {
        .featured-toc-links { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      }
      @media (max-width: 860px) {
        .featured-intro > .wrap { gap: 38px; }
        .featured-toc-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .hero,
        .grid-2,
        .grid-3 {
          grid-template-columns: 1fr;
        }
        .grid-4,
        .grid-5 {
          grid-template-columns: repeat(2, 1fr);
        }
        h1 {
          font-size: 38px;
        }
        /* Once the hero is a single column, the yaml panel shares the track
           with the copy block, and a grid item's automatic minimum size is its
           min-content width -- here the longest unwrapped line of colors.yml.
           That widens the track past the viewport and pushes every section's
           right padding off screen. min-width:0 lets the panel shrink to the
           track; the Shiki <pre> inside it already scrolls (overflow-x:auto,
           tabindex=0), so the long image: line stays reachable. Scoped to the
           collapsed layout: above 860px the two-column track sizing is
           load-bearing for the panel's width and must not change. */
        .yml {
          min-width: 0;
        }
      }
      @media (max-width: 520px) {
        .featured-toc-head { align-items: flex-start; flex-direction: column; gap: 3px; }
        .featured-toc-links { grid-template-columns: 1fr; }
        .grid-4,
        .grid-5 {
          grid-template-columns: 1fr;
        }
        /* Matches the specificity of the rules above rather than relying on
           `code { ... !important }`, which is what this replaced. */
        .install-row code,
        .astro-code,
        .astro-code code {
          font-size: 12px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }

      /* The DAG is a horizontal flex row with flex-wrap on desktop. Left to
         wrap on a narrow screen it breaks mid-flow and strands the connector
         lines at the end of a row, so below 860px it becomes a vertical
         sequence instead: the row turns into a column and each connector
         rotates from a 32x1 horizontal rule into a 1x20 vertical one. The
         stacked pairs (tofu-compute/tofu-smtp, ansible-local/ansible-remote)
         stay stacked -- that is what marks them as running in parallel.

         The ansible pair is a 2x2 grid rather than a plain column: github
         follows ansible-remote alone, so it sits in a second grid column on
         that row only, and the empty cell above it keeps the two ansible boxes
         one width. Below 860px the grid collapses to one column, the empty
         cell is dropped so it does not leave a gap, and the branch reads as a
         straight continuation of the vertical sequence. */
      @media (max-width: 860px) {
        .dag {
          flex-direction: column;
          align-items: stretch;
          flex-wrap: nowrap;
        }
        .dag > div {
          text-align: center;
        }
        .dag-edge {
          width: 1px;
          height: 20px;
          margin: 0 auto;
          flex: none;
        }
        .dag-group,
        .dag-branch {
          width: 100%;
          grid-template-columns: 1fr;
        }
        .dag-spacer {
          display: none;
        }
        .dag-tail {
          flex-direction: column;
          align-items: stretch;
        }
        .dag-panel {
          padding: 24px 20px;
        }
      }
    </style>
  </head>
  <body>
    <div class="page" id="top">

      <!-- NAV -->
      <SiteHeader active="featured" />

      <!-- FEATURED PACKAGE SKILLS -->
      <div class="sec featured-intro">
        <div class="wrap">
          <div class="featured-intro-copy">
            <div class="pill"><span>Curated by Colors</span></div>
            <h1>Featured</h1>
            <p class="sec-lede sec-lede-wide">Production examples that show what deterministic, agent-operated infrastructure looks like—from Kubernetes and data platforms to application hosting and remote development.</p>
          </div>
          <nav class="featured-toc" aria-label="Featured Package Skills on this page">
            <div class="featured-toc-head">
              <p class="featured-toc-title">On this page</p>
            </div>
            <div class="featured-toc-links">
              {/* No 01..23 markers: the order is neither alphabetical nor a
                  sequence, so the numerals encoded nothing and simply repeated
                  23 times -- tolerable down a 12-row column, noise in a
                  six-row grid. */}
              {featuredPackageSkills.map((item) => (
                <a href={item.href}>
                  <span>{item.label}</span>
                  <span class="featured-toc-arrow" aria-hidden="true">↓</span>
                </a>
              ))}
              <a class="featured-toc-all" href="/skills">
                <span>All {featuredPackageSkills.length} in the catalog</span>
                <span class="featured-toc-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </nav>
        </div>
      </div>

      <!-- K8S: FIRST EXAMPLE PACKAGE -->
      <div class="sec" id="k8s">
        <div class="wrap">
          <div class="eyebrow eyebrow-blue">{k8s.eyebrow}</div>
          <SectionHeading id="k8s" title={k8s.heading} />
          <p class="sec-lede sec-lede-wide">{k8s.lede}</p>

          <div class="sec-install">
            <InstallBox command={k8sInstallCmd} id="featured-k8s-install" />
            <span class="install-note" set:html={html(k8s.runtimeNote)} />
            <ResourceLinks docsUrl={k8s.docsUrl} repoUrl={k8s.repoUrl} catalogUrl="/getcolors/k8s" />
          </div>

          <div class="grid-5">
            {k8s.steps.map((s, i) => (
              <div class="step">
                <div class="eyebrow">{step(i)}</div>
                <h4>{s.title}</h4>
                <p set:html={html(s.body)} />
              </div>
            ))}
          </div>

          <div class="dag-panel">
            <div class="dag-caption">{k8s.dagCaption}</div>
            <div class="dag">
              {k8s.dag.map((item) => {
                if (item.kind === "edge") return <div class="dag-edge"></div>;
                return (
                  <div class:list={["dag-node", item.dark && "dag-start"]}>{item.label}</div>
                );
              })}
            </div>
            <p class="dag-note">{k8s.dagNote}</p>
          </div>
        </div>
      </div>

      <!-- K3S: SECOND EXAMPLE PACKAGE -->
      <div class="sec sec-alt" id="k3s">
        <div class="wrap">
          <div class="eyebrow eyebrow-blue">{k3s.eyebrow}</div>
          <SectionHeading id="k3s" title={k3s.heading} />
          <p class="sec-lede sec-lede-wide">{k3s.lede}</p>

          <div class="sec-install">
            <InstallBox command={k3sInstallCmd} id="featured-k3s-install" />
            <span class="install-note" set:html={html(k3s.runtimeNote)} />
            <ResourceLinks docsUrl={k3s.docsUrl} repoUrl={k3s.repoUrl} catalogUrl="/getcolors/k3s" />
          </div>

          <div class="grid-5">
            {k3s.steps.map((s, i) => (
              <div class="step">
                <div class="eyebrow">{step(i)}</div>
                <h4>{s.title}</h4>
                <p set:html={html(s.body)} />
              </div>
            ))}
          </div>

          <div class="dag-panel">
            <div class="dag-caption">{k3s.dagCaption}</div>
            <div class="dag">
              {k3s.dag.map((item) => {
                if (item.kind === "edge") return <div class="dag-edge"></div>;
                if (item.kind === "group")
                  return (
                    <div class="dag-group">
                      {item.nodes.map((n) => <div class="dag-node">{n}</div>)}
                    </div>
                  );
                return (
                  <div class:list={["dag-node", item.dark && "dag-start"]}>{item.label}</div>
                );
              })}
            </div>
            <p class="dag-note">{k3s.dagNote}</p>
          </div>
        </div>
      </div>


      <!-- UMAMI: ANALYTICS PACKAGE -->
      <div class="sec" id="umami">
        <div class="wrap">
          <div class="eyebrow eyebrow-blue">{umami.eyebrow}</div>
          <SectionHeading id="umami" title={umami.heading} />
          <p class="sec-lede sec-lede-wide">{umami.lede}</p>

          <div class="sec-install">
            <InstallBox command={umamiInstallCmd} id="featured-umami-install" />
            <span class="install-note" set:html={html(umami.runtimeNote)} />
            <ResourceLinks docsUrl={umami.docsUrl} repoUrl={umami.repoUrl} catalogUrl="/getcolors/umami" />
          </div>

          <div class="grid-5">
            {umami.steps.map((s, i) => (
              <div class="step">
                <div class="eyebrow">{step(i)}</div>
                <h4>{s.title}</h4>
                <p set:html={html(s.body)} />
              </div>
            ))}
          </div>

          <div class="dag-panel">
            <div class="dag-caption">{umami.dagCaption}</div>
            <div
              class="dag wide-dag"
              tabindex="0"
              aria-label="Umami create and build workflow diagram"
            >
              {umami.dag.map((item) => {
