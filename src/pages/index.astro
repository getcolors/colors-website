      /* The palette the design export expressed as a literal oklch() on every
         element it touched. Named here once so a hue change is one edit, and
         so the three library accents are declared next to each other rather
         than inferred from repetition. */
      :root {
        --ink: oklch(20% 0.01 260);
        --code-ink: oklch(35% 0.01 260);
        --muted: oklch(45% 0.01 260);
        --soft: oklch(55% 0.01 260);
        --line: oklch(91% 0.005 260);
        --rule: oklch(92% 0.005 260);
        --page: oklch(99% 0.002 90);
        --surface: oklch(97.5% 0.003 260);
        --panel: oklch(97% 0.005 260);
        --on-dark: oklch(96% 0.005 260);
        --red: oklch(60% 0.19 25);
        --green: oklch(65% 0.17 145);
        --blue: oklch(55% 0.18 260);
        /* The Context Skill accent — same purple as CatalogLayout's chip. */
        --context: oklch(55% 0.18 320);
        --mono: 'IBM Plex Mono', monospace;
      }

      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--page); font-family: 'IBM Plex Sans', Helvetica, Arial, sans-serif; }
      a { color: var(--blue); text-decoration: none; }
      a:hover { color: oklch(45% 0.18 260); }
      * { box-sizing: border-box; }

      .page { color: var(--ink); line-height: 1.5; }
      .wrap { max-width: 1072px; margin: 0 auto; }

      /* Section labels. The copy is stored title-case in src/data/landing.ts
         so the markdown twin reads naturally; the caps are presentational. */
      .eyebrow {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--soft);
        margin-bottom: 10px;
        text-transform: uppercase;
      }
      .eyebrow-blue { color: var(--blue); }
      .eyebrow-red { color: var(--red); }
      /* Green-only Package Skills key their section labels to that accent. */
      .eyebrow-green { color: var(--green); }
      /* Context Skill sections take the catalog's purple, so the matrix's
         second column stays legible while scrolling the full sections. */
      .eyebrow-context { color: var(--context); }

      /* HERO */
      .hero {
        max-width: 1120px;
        margin: 0 auto;
        padding: 64px 24px 88px;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 56px;
        align-items: center;
      }
      .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--blue);
        background: oklch(96% 0.03 260);
        border: 1px solid oklch(90% 0.05 260);
        padding: 6px 12px;
        border-radius: 100px;
        margin-bottom: 24px;
        text-transform: uppercase;
      }
      h1 { font-size: 52px; line-height: 1.08; letter-spacing: -0.02em; font-weight: 600; margin: 0 0 20px; }
      .hero-lede { font-size: 18px; color: var(--muted); margin: 0 0 32px; max-width: 520px; }

      .install { display: flex; flex-direction: column; gap: 12px; width: 100%; min-width: 0; max-width: 520px; }
      .install-note { font-size: 13px; color: var(--soft); }

      .yml {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 28px;
        font-family: var(--mono);
        font-size: 13px;
        color: var(--code-ink);
      }
      .yml-caption { color: var(--soft); margin-bottom: 14px; font-size: 12px; }

      /* SECTIONS */
      .sec { border-top: 1px solid var(--rule); padding: 72px 24px; }
      .sec-alt { background: var(--surface); }
      .sec h2 { font-size: 28px; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 12px; }
      /* A heading with no lede under it carries the lede's bottom margin. */
      .sec h2.solo { margin-bottom: 40px; }
      .sec-lede { font-size: 16px; color: var(--muted); margin: 0 0 40px; max-width: 640px; }
      .sec-lede-wide { max-width: 680px; }
      .definition p { max-width: 900px; margin: 0; color: var(--muted); font-size: 16px; }

      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
      .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
      .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
      /* K3s and Walter each have five steps. Their own class rather than a
         wider .grid-4, because .grid-4 lays out four-up card rows (the Shapes
         grid here, the four ONCE steps on /featured) and they must keep their
         width. Five tracks in the same 1120px wrap give a
         narrower card, so keep these bodies short. */
      .grid-5 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-bottom: 48px; }

      /* Cards — the browser/package pair. */
      .card { border: 1px solid var(--line); border-radius: 12px; padding: 28px; }
      .card h3 { font-size: 19px; font-weight: 600; margin: 0 0 10px; }
      .card p { font-size: 15px; color: var(--muted); margin: 0; }
      .card-accent { border-color: oklch(85% 0.06 260); background: oklch(97% 0.02 260); }
      .card-accent p { color: oklch(40% 0.01 260); }

      /* Outcome-first landing sections. */
      .example-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 48px; align-items: start; }
      .result-list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border: 1px solid var(--line); border-radius: 12px; background: var(--page); }
      .result-list li { position: relative; padding: 17px 20px 17px 52px; border-bottom: 1px solid var(--line); font-size: 14px; }
      .result-list li:last-child { border-bottom: 0; }
      .result-list li::before { content: "✓"; position: absolute; left: 20px; color: var(--green); font: 600 14px var(--mono); }
      .example-note { margin: 20px 0 0; color: var(--muted); font-size: 14px; }

      /* The Langfuse topology figure — the file in the hero, drawn. Colours are
         the page's custom properties; the SVG carries only geometry and class
         names, so a palette change here is one edit like everywhere else. */
      .example-grid { align-items: center; }
      .topology { margin: 0; min-width: 0; }
      .topology-scroll { overflow-x: auto; }
      .topology-svg { display: block; width: 100%; height: auto; }
      .topology-caption { margin: 10px 0 0; font: 12px var(--mono); color: var(--soft); }
      .t-vpc { fill: var(--surface); stroke: var(--soft); stroke-width: 1; stroke-dasharray: 5 4; }
      .t-group { fill: var(--page); stroke: var(--line); stroke-width: 1; }
      .t-group-blue { stroke: oklch(85% 0.06 260); fill: oklch(97% 0.02 260); }
      .t-group-red { stroke: oklch(85% 0.06 25); fill: oklch(97.5% 0.015 25); }
      .t-group-green { stroke: oklch(85% 0.07 145); fill: oklch(97.5% 0.02 145); }
      .t-group-soft { stroke: var(--line); fill: var(--panel); }
      .t-box { fill: var(--page); stroke: var(--line); stroke-width: 1; }
      .t-box-r2 { fill: var(--panel); }
      .t-edge { fill: none; stroke: var(--soft); stroke-width: 1.2; }
      .t-edge-dashed { stroke-dasharray: 3 3; }
      .t-arrow { fill: var(--soft); }
      .t-name { font: 500 12px 'IBM Plex Sans', Helvetica, Arial, sans-serif; fill: var(--ink); }
      .t-label { font: 10px var(--mono); letter-spacing: 0.04em; }
      .t-port { font: 10px var(--mono); fill: var(--code-ink); }
      .t-muted { fill: var(--muted); letter-spacing: 0; }
      .t-soft { fill: var(--soft); }
      .t-blue { fill: var(--blue); }
      .t-red { fill: var(--red); }
      .t-green { fill: var(--green); }
      .result-grid { grid-template-columns: 1fr 1fr; margin-top: 48px; }
      .result-grid li:nth-last-child(2) { border-bottom: 0; }
      .result-grid li:nth-child(odd) { border-right: 1px solid var(--line); }

      /* Shapes — the complex topologies from /featured, as links. */
      .shape-grid { margin-bottom: 0; }
      .shape { display: block; color: inherit; background: var(--page); transition: border-color 0.15s ease; }
      .shape:hover { color: inherit; border-color: var(--soft); }
      .shape h3 { font-size: 17px; }
      .shape p { font-size: 14px; }
      .shape-meta { font: 11px var(--mono); color: var(--blue); letter-spacing: 0.04em; margin-bottom: 12px; }
      .workflow-card { background: var(--page); border: 1px solid var(--line); border-radius: 12px; padding: 24px; }
      .workflow-command { display: inline-block; margin-bottom: 18px; padding: 7px 10px; border-radius: 6px; background: var(--ink); color: var(--on-dark); font: 12px var(--mono); }
      .workflow-card h3 { font-size: 17px; font-weight: 600; margin: 0 0 8px; }
      .workflow-card p { font-size: 14px; color: var(--muted); margin: 0; }
      .trust-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
      .trust-card { border: 1px solid var(--line); border-radius: 10px; padding: 22px; background: var(--page); }
      .trust-card h3 { font-size: 16px; font-weight: 600; margin: 0 0 7px; }
      .trust-card p { font-size: 14px; color: var(--muted); margin: 0; }

      /* Cards — the three libraries. */
      .lib {
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 24px;
        color: inherit;
      }
      .lib:hover { border-color: oklch(80% 0.01 260); }
      .lib-swatch { width: 32px; height: 32px; border-radius: 8px; margin-bottom: 16px; }
      .lib h3 { font-size: 17px; font-weight: 600; margin: 0 0 4px; font-family: var(--mono); }
      .lib-stack { font-size: 13px; color: var(--soft); margin-bottom: 12px; }
      .lib p { font-size: 14px; color: var(--muted); margin: 0 0 12px; }

      /* Cards — the four Once steps. */
      /* The Agent Skill matrix: verbs down, skill kinds across. Column headers
         reuse the eyebrow treatment in each kind's accent; the cells are anchor
         cards into the four full sections below. Below 860px the headers
         disappear and the cells stack — each title names both verb and kind,
         so no information is lost. */
      .matrix { display: grid; grid-template-columns: auto 1fr 1fr; gap: 16px 24px; }
      .matrix-head { margin-bottom: 0; align-self: end; }
      .matrix-verb { margin-bottom: 0; align-self: center; }
      .matrix-cell { display: block; border: 1px solid var(--line); border-radius: 10px; padding: 20px; background: var(--page); color: var(--ink); }
      .matrix-cell:hover { color: var(--ink); border-color: oklch(78% 0.01 260); }
      .matrix-cell h4 { font-size: 15px; font-weight: 600; margin: 0 0 6px; }
      .matrix-cell p { font-size: 13px; color: var(--muted); margin: 0; }

      .step { border: 1px solid var(--line); border-radius: 10px; padding: 20px; background: var(--page); }
      .step .eyebrow { font-size: 11px; margin-bottom: 8px; }
      .step h4 { font-size: 15px; font-weight: 600; margin: 0 0 6px; }
      .step p { font-size: 13px; color: var(--muted); margin: 0; }

      /* DAG */
      .dag-panel { border: 1px solid var(--line); border-radius: 12px; padding: 36px; background: var(--page); }
      .dag-caption { font-family: var(--mono); font-size: 12px; color: var(--soft); margin-bottom: 24px; }
      .dag { display: flex; align-items: center; gap: 0; flex-wrap: wrap; font-family: var(--mono); font-size: 13px; }
      .dag-node { background: white; border: 1px solid oklch(85% 0.005 260); padding: 10px 16px; border-radius: 8px; }
      /* No border, matching the export — it sits 2px shorter than its
         neighbours and align-items:center absorbs the difference. */
      .dag-start { background: var(--ink); color: white; border: none; }
      .dag-edge { width: 32px; height: 1px; background: oklch(80% 0.005 260); }
      .dag-group { display: flex; flex-direction: column; gap: 8px; }
      .dag-branch { display: grid; grid-template-columns: auto auto; gap: 8px 0; align-items: center; }
      .dag-tail { display: flex; align-items: center; }
      .dag-note { font-size: 13px; color: var(--muted); margin: 20px 0 0; }
      /* Long graphs keep their desktop flow on one line and scroll only the
         diagram, not the panel. */
      @media (min-width: 861px) {
        .wide-dag {
          flex-wrap: nowrap;
          overflow-x: auto;
          padding-bottom: 8px;
        }
        .wide-dag > * { flex: none; }
      }
      /* Walter shows two panels — create/build, then the power pair — and the
         power panel holds two graphs under one caption. */
      .dag-panel + .dag-panel { margin-top: 20px; }
      .dag + .dag { margin-top: 16px; }
      .sec-install { margin: 0 0 40px; }
      .sec-install .install-note { display: block; margin: 10px 0 0; }

      /* CTA */
      .cta { border-top: 1px solid var(--rule); padding: 80px 24px; text-align: center; }
      .cta-inner { max-width: 640px; margin: 0 auto; }
      .cta h2 { font-size: 30px; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 16px; }
      .cta p { font-size: 16px; color: var(--muted); margin: 0 0 32px; }
      .catalog-link { display: inline-flex; align-items: center; gap: 8px; padding: 14px 20px; border-radius: 8px; background: var(--ink); color: var(--on-dark); font: 13px var(--mono); }
      .catalog-link svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .catalog-link:hover { background: oklch(30% 0.01 260); color: white; }

      /* Shiki emits <pre><code>, and both pick up the UA monospace family
         rather than inheriting the panel's. Reapply it, or the hero's YAML
         stops matching every other block of code on the page. */
      .astro-code,
      .astro-code code {
        font-family: var(--mono);
        font-size: 13px;
      }

      /* Responsive collapse. The export ships no media queries; these rules
         only take effect below 860px and leave the desktop design untouched.
         They no longer need !important — the declarations they override are
         now in this stylesheet rather than in style attributes, so ordinary
         cascade order settles it. Keep these blocks last. */
      @media (max-width: 860px) {
        .hero,
        .grid-2,
        .grid-3,
        .example-grid,
        .trust-grid,
        .matrix {
          grid-template-columns: 1fr;
        }
        .matrix-head,
        .matrix-verb,
        .matrix-corner {
          display: none;
        }
        /* The no-wrap command/prompt panel must not become the hero track's
           automatic minimum width on narrow screens. */
        .hero > div:first-child { min-width: 0; }
        .grid-4,
        .grid-5 {
          grid-template-columns: repeat(2, 1fr);
        }
        h1 {
          font-size: 38px;
        }
        /* Once the hero is a single column, the yaml panel shares the track
           with the copy block, and a grid item's automatic minimum size is its
           min-content width -- here the longest unwrapped line of colors.yml.
           That widens the track past the viewport and pushes every section's
           right padding off screen. min-width:0 lets the panel shrink to the
           track; the Shiki <pre> inside it already scrolls (overflow-x:auto,
           tabindex=0), so the long image: line stays reachable. Scoped to the
           collapsed layout: above 860px the two-column track sizing is
           load-bearing for the panel's width and must not change. */
        .yml {
          min-width: 0;
        }
      }
      @media (max-width: 520px) {
        .grid-4,
        .grid-5 {
          grid-template-columns: 1fr;
        }
        .astro-code,
        .astro-code code {
          font-size: 12px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }

      /* The DAG is a horizontal flex row with flex-wrap on desktop. Left to
         wrap on a narrow screen it breaks mid-flow and strands the connector
         lines at the end of a row, so below 860px it becomes a vertical
         sequence instead: the row turns into a column and each connector
         rotates from a 32x1 horizontal rule into a 1x20 vertical one. The
         stacked pairs (tofu-compute/tofu-smtp, ansible-local/ansible-remote)
         stay stacked -- that is what marks them as running in parallel.

         The ansible pair is a 2x2 grid rather than a plain column: github
         follows ansible-remote alone, so it sits in a second grid column on
         that row only, and the empty cell above it keeps the two ansible boxes
         one width. Below 860px the grid collapses to one column, the empty
         cell is dropped so it does not leave a gap, and the branch reads as a
         straight continuation of the vertical sequence. */
      @media (max-width: 860px) {
        .dag {
          flex-direction: column;
          align-items: stretch;
          flex-wrap: nowrap;
        }
        .dag > div {
          text-align: center;
        }
        .dag-edge {
          width: 1px;
          height: 20px;
          margin: 0 auto;
          flex: none;
        }
        .dag-group,
        .dag-branch {
          width: 100%;
          grid-template-columns: 1fr;
        }
        .dag-spacer {
          display: none;
        }
        .dag-tail {
          flex-direction: column;
          align-items: stretch;
        }
        .dag-panel {
          padding: 24px 20px;
        }
      }
      /* Appended after the blocks above on purpose: media rules stay last so
         ordinary cascade order settles them (see CLAUDE.md). .grid-4 already
         collapses .shape-grid to two columns and then one. */
      @media (max-width: 860px) {
        .result-grid { grid-template-columns: 1fr; margin-top: 40px; }
        .result-grid li:nth-child(odd) { border-right: 0; }
        .result-grid li:nth-last-child(2) { border-bottom: 1px solid var(--line); }
      }
      @media (max-width: 520px) {
        /* Ten-point mono labels vanish once the 640-unit viewBox scales below
           ~0.85; hold the drawing at a legible width and let the figure's own
           container scroll instead of the page. */
        .topology-svg { min-width: 560px; }
      }
    </style>
  </head>
  <body>
    <div class="page" id="top">

      <!-- NAV -->
      <SiteHeader />

      <!-- HERO -->
      <div class="hero">
        <div>
          <div class="pill"><span>{hero.eyebrow}</span></div>
          <h1>{hero.headline}</h1>
          <p class="hero-lede">{hero.lede}</p>
          <div class="install">
            <InstallBox command={installCmd} id="hero-install" />
            <span class="install-note" set:html={html(hero.installNote)} />
          </div>
        </div>
        <div class="yml">
          <div class="yml-caption">{hero.ymlCaption}</div>
          <Code
            code={colorsYml}
            lang="yaml"
            theme={yamlTheme}
            style="margin:0; background:transparent; line-height:1.7"
          />
        </div>
      </div>

      <!-- REAL-LIFE EXAMPLE -->
      <div class="sec" id="langfuse-example">
        <div class="wrap">
          <div class="example-grid">
            <div>
              <div class="eyebrow eyebrow-green">{realExample.eyebrow}</div>
              <SectionHeading id="langfuse-example" title={realExample.heading} />
              <p class="sec-lede">{realExample.lede}</p>
              <ResourceLinks docsUrl="https://getcolors.github.io/langfuse/" repoUrl="https://github.com/getcolors/langfuse" catalogUrl="/getcolors/langfuse" />
            </div>
            <figure class="topology">
              <div class="topology-scroll">
                <!-- Drawn from langfuse-vultr's colors.yml: four firewall groups,
                     six machines, one VPC; the edges are the ports the east-west
                     rules name. Colours come from the page's custom properties so
                     the figure follows the palette. -->
                <svg viewBox="0 0 640 430" role="img" aria-labelledby="topo-title topo-desc" class="topology-svg">
                  <title id="topo-title">The langfuse-vultr topology</title>
                  <desc id="topo-desc">One Vultr VPC holding four firewall groups: an application host running langfuse-web, langfuse-worker and Caddy; a Redis host; three ClickHouse replicas each with a Keeper; and a Neon storage host running the storage broker, pageserver, safekeeper and compute. Cloudflare reaches only the app host on port 443. The app host reaches Redis on 6379, ClickHouse on 8123 and 9000, and Neon on 5432. The replicas talk to each other on 9009, 9181 and 9234. Cloudflare R2 holds raw events and media, Neon layers and WAL, and the backups.</desc>
                  <defs>
                    <marker id="arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                      <path d="M0 0.8 L7.4 4 L0 7.2 Z" class="t-arrow" />
                    </marker>
                  </defs>

                  <!-- VPC -->
                  <rect x="118" y="22" width="504" height="322" rx="14" class="t-vpc" />
                  <text x="134" y="43" class="t-label t-soft">VPC 10.50.0.0/24 · ams</text>

                  <!-- Cloudflare, outside -->
                  <rect x="10" y="88" width="88" height="44" rx="8" class="t-box" />
                  <text x="54" y="107" text-anchor="middle" class="t-name">Cloudflare</text>
                  <text x="54" y="122" text-anchor="middle" class="t-label t-soft">proxied DNS</text>
                  <path d="M98 110 H142" class="t-edge" marker-end="url(#arrow)" />
                  <text x="120" y="102" text-anchor="middle" class="t-port">:443</text>

                  <!-- app group -->
                  <rect x="142" y="62" width="214" height="96" rx="10" class="t-group t-group-blue" />
                  <text x="156" y="82" class="t-label t-blue">APP · vc2-4c-8gb</text>
                  <rect x="156" y="92" width="186" height="52" rx="6" class="t-box" />
                  <text x="249" y="113" text-anchor="middle" class="t-name">langfuse-web · langfuse-worker</text>
                  <text x="249" y="130" text-anchor="middle" class="t-label t-muted">caddy · TLS from Let’s Encrypt</text>

                  <!-- redis group -->
                  <rect x="428" y="62" width="170" height="96" rx="10" class="t-group t-group-soft" />
                  <text x="442" y="82" class="t-label t-soft">REDIS · vc2-1c-2gb</text>
                  <rect x="442" y="92" width="142" height="52" rx="6" class="t-box" />
                  <text x="513" y="113" text-anchor="middle" class="t-name">redis 7.2</text>
                  <text x="513" y="130" text-anchor="middle" class="t-label t-muted">queues · cache</text>

                  <!-- app -> redis -->
                  <path d="M356 118 H426" class="t-edge" marker-end="url(#arrow)" />
                  <text x="391" y="110" text-anchor="middle" class="t-port">:6379</text>

                  <!-- clickhouse group -->
                  <rect x="142" y="196" width="284" height="130" rx="10" class="t-group t-group-red" />
                  <text x="156" y="216" class="t-label t-red">CLICKHOUSE · 3 × vc2-4c-8gb</text>
                  <rect x="156" y="228" width="80" height="56" rx="6" class="t-box" />
                  <text x="196" y="250" text-anchor="middle" class="t-name">node 0</text>
                  <text x="196" y="266" text-anchor="middle" class="t-label t-muted">+ keeper</text>
                  <rect x="244" y="228" width="80" height="56" rx="6" class="t-box" />
                  <text x="284" y="250" text-anchor="middle" class="t-name">node 1</text>
                  <text x="284" y="266" text-anchor="middle" class="t-label t-muted">+ keeper</text>
                  <rect x="332" y="228" width="80" height="56" rx="6" class="t-box" />
                  <text x="372" y="250" text-anchor="middle" class="t-name">node 2</text>
                  <text x="372" y="266" text-anchor="middle" class="t-label t-muted">+ keeper</text>
                  <path d="M236 256 H244 M324 256 H332" class="t-edge" />
                  <text x="284" y="310" text-anchor="middle" class="t-port">↔ :9009 · :9181 keeper · :9234 raft</text>

                  <!-- app -> clickhouse -->
                  <path d="M196 158 V226" class="t-edge" marker-end="url(#arrow)" />
                  <text x="204" y="182" class="t-port">:8123 · :9000</text>

                  <!-- neon group -->
                  <rect x="442" y="196" width="156" height="130" rx="10" class="t-group t-group-green" />
                  <text x="456" y="216" class="t-label t-green">NEON · vc2-4c-8gb</text>
                  <rect x="456" y="228" width="128" height="86" rx="6" class="t-box" />
                  <text x="520" y="250" text-anchor="middle" class="t-name">postgres 17</text>
                  <text x="520" y="268" text-anchor="middle" class="t-label t-muted">broker · pageserver</text>
                  <text x="520" y="284" text-anchor="middle" class="t-label t-muted">safekeeper · compute</text>
                  <text x="520" y="302" text-anchor="middle" class="t-label t-muted">layers + WAL → R2</text>

                  <!-- app -> neon -->
                  <path d="M320 158 V178 H520 V194" class="t-edge" marker-end="url(#arrow)" />
                  <text x="528" y="176" class="t-port">:5432</text>

                  <!-- R2 band, outside -->
                  <path d="M196 326 V366 M520 326 V366" class="t-edge t-edge-dashed" />
                  <rect x="142" y="366" width="456" height="50" rx="8" class="t-box t-box-r2" />
                  <text x="370" y="386" text-anchor="middle" class="t-name">Cloudflare R2</text>
                  <text x="370" y="403" text-anchor="middle" class="t-label t-muted">raw events &amp; media · Neon layers &amp; WAL · Postgres, ClickHouse and media backups</text>
                </svg>
              </div>
              <figcaption class="topology-caption">{topology.caption}</figcaption>
            </figure>
          </div>
          <ul class="result-list result-grid">
            {realExample.results.map((result) => <li>{result}</li>)}
          </ul>
          <p class="example-note" set:html={html(realExample.note)} />
        </div>
      </div>

      <!-- SHAPES -->
      <div class="sec sec-alt" id="shapes">
        <div class="wrap">
          <div class="eyebrow eyebrow-blue">{shapes.eyebrow}</div>
          <SectionHeading id="shapes" title={shapes.heading} />
          <p class="sec-lede sec-lede-wide">{shapes.lede}</p>
          <div class="grid-4 shape-grid">
            {shapes.items.map((item) => (
              <a class="card shape" href={item.href}>
                <div class="shape-meta">{item.meta}</div>
                <h3>{item.name}</h3>
                <p>{item.body}</p>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- SAFE LOCAL WORKFLOW -->
      <div class="sec sec-alt" id="workflow">
        <div class="wrap">
          <SectionHeading id="workflow" title={workflow.heading} />
          <p class="sec-lede sec-lede-wide">{workflow.lede}</p>
          <div class="grid-3">
            {workflow.steps.map((step) => (
              <div class="workflow-card">
                <code class="workflow-command">{step.command}</code>
                <h3>{step.title}</h3>
                <p set:html={html(step.body)} />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- WHY ANOTHER LAYER -->
      <div class="sec" id="why-colors">
        <div class="wrap">
          <SectionHeading id="why-colors" title={difference.heading} />
          <p class="sec-lede sec-lede-wide">{difference.lede}</p>
          <div class="grid-3">
            {difference.cards.map((c) => (
              <div class="card">
                <div class="eyebrow eyebrow-blue">{c.label}</div>
                <h3>{c.title}</h3>
                <p set:html={html(c.body)} />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- TRUST AND FIT -->
      <div class="sec sec-alt" id="trust">
        <div class="wrap">
          <SectionHeading id="trust" title={trust.heading} headingClass="solo" />
          <div class="trust-grid">
            {trust.cards.map((c) => (
              <div class="trust-card">
                <div class="eyebrow eyebrow-green">{c.label}</div>
                <h3>{c.title}</h3>
                <p set:html={html(c.body)} />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- THREE LIBRARIES -->
      <div class="sec" id="libraries">
        <div class="wrap">
          <SectionHeading id="libraries" title={libraries.heading} />
          <p class="sec-lede">{libraries.lede}</p>
          <div class="grid-3">
            {libraries.items.map((l) => (
              <div class="lib">
                <div class="lib-swatch" style={`background:${l.accent}`}></div>
                <h3>{l.name}</h3>
                <div class="lib-stack">{l.stack}</div>
                <p>{l.blurb}</p>
                <ResourceLinks docsUrl={l.docsUrl} repoUrl={l.repoUrl} card />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- THE AGENT SKILL MATRIX -->
      <div class="sec sec-alt" id="agent-skills">
        <div class="wrap">
          <SectionHeading id="agent-skills" title={skillMatrix.heading} />
          <p class="sec-lede sec-lede-wide">{skillMatrix.lede}</p>
          <div class="matrix">
            <div class="matrix-corner" aria-hidden="true"></div>
            <div class="matrix-head eyebrow eyebrow-red">{skillMatrix.columns[0]}</div>
            <div class="matrix-head eyebrow eyebrow-context">{skillMatrix.columns[1]}</div>
            {skillMatrix.rows.map((row) => (
              <>
                <div class="matrix-verb eyebrow">{row.verb}</div>
                {row.cells.map((cell) => (
                  <a class="matrix-cell" href={cell.href}>
                    <h4>{cell.title}</h4>
                    <p>{cell.body}</p>
                  </a>
                ))}
              </>
            ))}
          </div>
        </div>
      </div>

      <!-- AGENT SKILL: CREATE A PACKAGE SKILL -->
      <div class="sec" id="create-package-skill">
        <div class="wrap">
          <div class="eyebrow eyebrow-red">{createPackageSkill.eyebrow}</div>
          <SectionHeading id="create-package-skill" title={createPackageSkill.heading} />
          <p class="sec-lede sec-lede-wide">{createPackageSkill.lede}</p>

          <div class="sec-install">
            <InstallBox command={createPackageSkillCmd} prompt={createPackageSkillPrompt} id="create-package-skill-install" />
            <span class="install-note" set:html={html(createPackageSkill.useNote)} />
            <ResourceLinks docsUrl={createPackageSkill.docsUrl} repoUrl={createPackageSkill.repoUrl} />
          </div>

          <div class="grid-3">
            {createPackageSkill.phases.map((phase, i) => (
              <div class="step">
                <div class="eyebrow">{`Phase ${i + 1}`}</div>
                <h4>{phase.title}</h4>
                <p set:html={html(phase.body)} />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- AGENT SKILL: SUBMIT A PACKAGE SKILL -->
      <div class="sec sec-alt" id="submit-package-skill">
        <div class="wrap">
          <div class="eyebrow eyebrow-red">{submitPackageSkill.eyebrow}</div>
          <SectionHeading id="submit-package-skill" title={submitPackageSkill.heading} />
          <p class="sec-lede sec-lede-wide">{submitPackageSkill.lede}</p>

          <div class="sec-install">
            <InstallBox command={submitPackageSkillCmd} prompt={submitPackageSkillPrompt} id="submit-package-skill-install" />
            <span class="install-note" set:html={html(submitPackageSkill.useNote)} />
            <ResourceLinks docsUrl={submitPackageSkill.docsUrl} repoUrl={submitPackageSkill.repoUrl} />
          </div>

          <div class="grid-3">
            {submitPackageSkill.phases.map((phase, i) => (
              <div class="step">
                <div class="eyebrow">{`Phase ${i + 1}`}</div>
                <h4>{phase.title}</h4>
                <p set:html={html(phase.body)} />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- AGENT SKILL: CREATE A CONTEXT SKILL -->
      <div class="sec" id="create-context-skill">
        <div class="wrap">
          <div class="eyebrow eyebrow-context">{createContextSkill.eyebrow}</div>
          <SectionHeading id="create-context-skill" title={createContextSkill.heading} />
          <p class="sec-lede sec-lede-wide">{createContextSkill.lede}</p>

          <div class="sec-install">
            <InstallBox command={createContextSkillCmd} prompt={createContextSkillPrompt} id="create-context-skill-install" />
            <span class="install-note" set:html={html(createContextSkill.useNote)} />
            <ResourceLinks docsUrl={createContextSkill.docsUrl} repoUrl={createContextSkill.repoUrl} />
          </div>

          <div class="grid-3">
            {createContextSkill.phases.map((phase, i) => (
              <div class="step">
                <div class="eyebrow">{`Phase ${i + 1}`}</div>
                <h4>{phase.title}</h4>
                <p set:html={html(phase.body)} />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- AGENT SKILL: SUBMIT A CONTEXT SKILL -->
      <div class="sec sec-alt" id="submit-context-skill">
        <div class="wrap">
          <div class="eyebrow eyebrow-context">{submitContextSkill.eyebrow}</div>
          <SectionHeading id="submit-context-skill" title={submitContextSkill.heading} />
          <p class="sec-lede sec-lede-wide">{submitContextSkill.lede}</p>

          <div class="sec-install">
            <InstallBox command={submitContextSkillCmd} prompt={submitContextSkillPrompt} id="submit-context-skill-install" />
            <span class="install-note" set:html={html(submitContextSkill.useNote)} />
            <ResourceLinks docsUrl={submitContextSkill.docsUrl} repoUrl={submitContextSkill.repoUrl} />
          </div>

          <div class="grid-3">
            {submitContextSkill.phases.map((phase, i) => (
              <div class="step">
                <div class="eyebrow">{`Phase ${i + 1}`}</div>
                <h4>{phase.title}</h4>
                <p set:html={html(phase.body)} />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- FINAL CTA -->
      <div class="cta" id="catalog">
        <div class="cta-inner">
          <SectionHeading id="catalog" title="Find infrastructure your agent can operate." centered />
          <p>Browse the PR-curated Skills Catalog by platform, provider, or runtime.</p>
          <a class="catalog-link" href="/skills"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg><span>View the Catalog</span></a>

        </div>
      </div>

      <!-- FOOTER -->
      <SiteFooter />

    </div>

  </body>
</html>
