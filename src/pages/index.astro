---
import { Code } from "astro:components";
import InstallBox from "~/components/InstallBox.astro";
import ResourceLinks from "~/components/ResourceLinks.astro";
import SectionHeading from "~/components/SectionHeading.astro";
import SeoMeta from "~/components/SeoMeta.astro";
import StyleGate from "~/components/StyleGate.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import { yamlTheme } from "~/data/yaml-theme";
import {
  colorsYml,
  createContextSkill,
  createContextSkillCmd,
  createContextSkillPrompt,
  createPackageSkill,
  createPackageSkillCmd,
  createPackageSkillPrompt,
  difference,
  hero,
  html,
  installCmd,
  libraries,
  meta,
  realExample,
  shapes,
  skillMatrix,
  submitContextSkill,
  submitContextSkillCmd,
  submitContextSkillPrompt,
  submitPackageSkill,
  submitPackageSkillCmd,
  submitPackageSkillPrompt,
  topology,
  trust,
  workflow,
} from "~/data/landing";

const { title, description } = meta;

// The hero's YAML theme lives in src/data/yaml-theme.ts, shared with the town
// hall page. Shiki ships with Astro, so highlighting costs no new dependency.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <SeoMeta title={title} description={description} path="/" />
    <StyleGate />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
