      body { margin: 0; background: oklch(99% 0.002 90); font-family: 'IBM Plex Sans', Helvetica, Arial, sans-serif; }
        a { color: oklch(55% 0.18 260); text-decoration: none; }
        a:hover { color: oklch(45% 0.18 260); }
        * { box-sizing: border-box; }

      .h1:hover { background: oklch(35% 0.01 260); }
      .h2:hover { border-color: oklch(80% 0.01 260); }

      /* Responsive collapse. The export ships no media queries; these rules
         only take effect below 860px and leave the desktop design untouched.
         !important is required to override the inline styles. */
      @media (max-width: 860px) {
        .r-hero,
        .r-2,
        .r-3 {
          grid-template-columns: 1fr !important;
        }
        .r-4 {
          grid-template-columns: repeat(2, 1fr) !important;
        }
        h1 {
          font-size: 38px !important;
        }
      }
      @media (max-width: 520px) {
        .r-4 {
          grid-template-columns: 1fr !important;
        }
        code {
          font-size: 12px !important;
        }
      }

      /* The DAG is a horizontal flex row with flex-wrap on desktop. Left to
         wrap on a narrow screen it breaks mid-flow and strands the connector
         lines at the end of a row, so below 860px it becomes a vertical
         sequence instead: the row turns into a column and each connector
         rotates from a 32x1 horizontal rule into a 1x20 vertical one. The
         stacked pairs (tofu-compute/tofu-smtp, ansible-local/ansible-remote)
         stay stacked -- that is what marks them as running in parallel. */
      @media (max-width: 860px) {
        .dag {
          flex-direction: column !important;
          align-items: stretch !important;
          flex-wrap: nowrap !important;
        }
        .dag > div {
          text-align: center;
        }
        .dag-edge {
          width: 1px !important;
          height: 20px !important;
          margin: 0 auto !important;
          flex: none !important;
        }
        .dag-group {
          width: 100%;
        }
        .dag-panel {
          padding: 24px 20px !important;
        }
      }
    </style>
  </head>
  <body>
    <div style="color: oklch(20% 0.01 260); line-height: 1.5;">

      <!-- NAV -->
      <div style="display:flex; align-items:center; justify-content:space-between; max-width:1120px; margin:0 auto; padding:28px 24px;">
        <div style="display:flex; align-items:center; gap:10px;">
          <div style="width:20px; height:20px; border-radius:4px; overflow:hidden; display:flex;">
            <div style="flex:1; background:oklch(60% 0.19 25);"></div>
            <div style="flex:1; background:oklch(65% 0.17 145);"></div>
            <div style="flex:1; background:oklch(55% 0.18 260);"></div>
          </div>
          <span style="font-weight:600; font-size:15px; letter-spacing:-0.01em;">Colors</span>
        </div>
        <div style="display:flex; align-items:center; gap:28px; font-size:14px; color:oklch(45% 0.01 260);">
          <a href="#libraries" style="color:oklch(45% 0.01 260);">Libraries</a>
          <a href="#once" style="color:oklch(45% 0.01 260);">Once</a>
        </div>
      </div>

      <!-- HERO -->
      <div style="max-width:1120px; margin:0 auto; padding:64px 24px 88px; display:grid; grid-template-columns:1.1fr 0.9fr; gap:56px; align-items:center;" class="r-hero">
        <div>
          <div style="display:inline-flex; align-items:center; gap:8px; font-family:'IBM Plex Mono',monospace; font-size:12px; color:oklch(55% 0.18 260); background:oklch(96% 0.03 260); border:1px solid oklch(90% 0.05 260); padding:6px 12px; border-radius:100px; margin-bottom:24px;">
            <span>AN SDK FOR PACKAGE SKILLS</span>
          </div>
          <h1 style="font-size:52px; line-height:1.08; letter-spacing:-0.02em; font-weight:600; margin:0 0 20px;">Colors is an SDK for building Package Skills.</h1>
          <p style="font-size:18px; color:oklch(45% 0.01 260); margin:0 0 32px; max-width:520px;">Three libraries — red, green, and blue — give agents dry-run guarantees, secret indirection, and strict lifecycle control over real infrastructure, in the runtime your team already uses.</p>
          <div style="display:flex; flex-direction:column; gap:12px; max-width:480px;">
            <div style="display:flex; align-items:center; justify-content:space-between; background:oklch(20% 0.01 260); border-radius:8px; padding:14px 16px;">
              <code style="font-family:'IBM Plex Mono',monospace; font-size:14px; color:oklch(96% 0.005 260);">npx skills use getcolors/once</code>
              <button data-copy="npx skills use getcolors/once" style="background:oklch(30% 0.01 260); color:oklch(96% 0.005 260); border:none; border-radius:6px; padding:6px 12px; font-size:12px; font-family:'IBM Plex Mono',monospace; cursor:pointer;" class="h1">Copy</button>
            </div>
            <span style="font-size:13px; color:oklch(55% 0.01 260);">Run inside your coding agent — it grants <strong>Once</strong>, a skill to provision a VPS with a personal PaaS like Netlify or Vercel.</span>
          </div>
        </div>
        <div style="background:oklch(97% 0.005 260); border:1px solid oklch(91% 0.005 260); border-radius:12px; padding:28px; font-family:'IBM Plex Mono',monospace; font-size:13px; color:oklch(35% 0.01 260);">
          <div style="color:oklch(55% 0.01 260); margin-bottom:14px; font-size:12px;"># colors.yml</div>
          <div style="white-space:pre; line-height:1.7;">host: app.example.com
    env:
      site-database-url:
        -&gt; COLORS_PAR_SITE_DATABASE_URL
    dns: managed
    smtp: managed
    apps:
      - once/site</div>
        </div>
      </div>

      <!-- BROWSER VS PACKAGE -->
      <div style="border-top:1px solid oklch(92% 0.005 260); padding:72px 24px;">
        <div style="max-width:1120px; margin:0 auto;">
          <h2 style="font-size:28px; font-weight:600; letter-spacing:-0.01em; margin:0 0 12px;">A different primitive for a different job</h2>
          <p style="font-size:16px; color:oklch(45% 0.01 260); margin:0 0 40px; max-width:640px;">Web automation and infrastructure automation demand different guarantees.</p>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;" class="r-2">
            <div style="border:1px solid oklch(91% 0.005 260); border-radius:12px; padding:28px;">
              <div style="font-family:'IBM Plex Mono',monospace; font-size:12px; color:oklch(55% 0.01 260); margin-bottom:10px;">BROWSER SKILL</div>
              <h3 style="font-size:19px; font-weight:600; margin:0 0 10px;">Eyes and hands on the web</h3>
              <p style="font-size:15px; color:oklch(45% 0.01 260); margin:0;">Navigates DOM elements, fills forms, scrapes content — bridges natural language intent with web interaction.</p>
            </div>
            <div style="border:1px solid oklch(85% 0.06 260); background:oklch(97% 0.02 260); border-radius:12px; padding:28px;">
              <div style="font-family:'IBM Plex Mono',monospace; font-size:12px; color:oklch(55% 0.18 260); margin-bottom:10px;">PACKAGE SKILL</div>
              <h3 style="font-size:19px; font-weight:600; margin:0 0 10px;">Determinism and lifecycle control</h3>
              <p style="font-size:15px; color:oklch(40% 0.01 260); margin:0;">Provisions platforms, infrastructures, and containers — with dry-run boundaries and strict credential handling instead of raw shell access.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- WHAT'S INSIDE -->
      <div style="border-top:1px solid oklch(92% 0.005 260); padding:72px 24px; background:oklch(97.5% 0.003 260);">
        <div style="max-width:1120px; margin:0 auto;">
          <h2 style="font-size:28px; font-weight:600; letter-spacing:-0.01em; margin:0 0 40px;">What a Package Skill bundles</h2>
          <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px;" class="r-3">

              <div style="background:oklch(99% 0.002 90); border:1px solid oklch(91% 0.005 260); border-radius:12px; padding:24px;">
                <div style="font-family:'IBM Plex Mono',monospace; font-size:12px; color:oklch(55% 0.18 260); margin-bottom:12px;">DESIRED STATE</div>
                <h3 style="font-size:17px; font-weight:600; margin:0 0 8px;">Non-secret desired state</h3>
                <p style="font-size:14px; color:oklch(45% 0.01 260); margin:0;">colors.yml declares hostnames, DNS zones, and mail domains directly — no separate settings to keep in sync.</p>
              </div>

              <div style="background:oklch(99% 0.002 90); border:1px solid oklch(91% 0.005 260); border-radius:12px; padding:24px;">
                <div style="font-family:'IBM Plex Mono',monospace; font-size:12px; color:oklch(55% 0.18 260); margin-bottom:12px;">RUNTIMES</div>
                <h3 style="font-size:17px; font-weight:600; margin:0 0 8px;">Deterministic runtimes & launchers</h3>
                <p style="font-size:14px; color:oklch(45% 0.01 260); margin:0;">Colors’ three pinned runtimes — Bun, Babashka, or uv — not ad-hoc shell scripts.</p>
              </div>

              <div style="background:oklch(99% 0.002 90); border:1px solid oklch(91% 0.005 260); border-radius:12px; padding:24px;">
                <div style="font-family:'IBM Plex Mono',monospace; font-size:12px; color:oklch(55% 0.18 260); margin-bottom:12px;">CREDENTIALS</div>
                <h3 style="font-size:17px; font-weight:600; margin:0 0 8px;">Environment & credential boundaries</h3>
                <p style="font-size:14px; color:oklch(45% 0.01 260); margin:0;">Secrets stay in COLORS_PAR_* env vars, referenced by name and never rendered into files.</p>
              </div>

          </div>
        </div>
      </div>

      <!-- THREE LIBRARIES -->
      <div id="libraries" style="border-top:1px solid oklch(92% 0.005 260); padding:72px 24px;">
        <div style="max-width:1120px; margin:0 auto;">
          <h2 style="font-size:28px; font-weight:600; letter-spacing:-0.01em; margin:0 0 12px;">Three libraries. One SDK.</h2>
          <p style="font-size:16px; color:oklch(45% 0.01 260); margin:0 0 40px; max-width:640px;">Colors is an SDK made of three interchangeable libraries for building Package Skills. Pick the runtime your team already uses — the guarantees don't change: dry-run boundaries, secret indirection, identical desired-state semantics.</p>
          <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px;" class="r-3">

              <a href="https://github.com/getcolors/red" style="display:block; background:oklch(97.5% 0.003 260); border:1px solid oklch(91% 0.005 260); border-radius:12px; padding:24px; color:inherit;" class="h2">
                <div style="width:32px; height:32px; border-radius:8px; background:oklch(60% 0.19 25); margin-bottom:16px;"></div>
                <h3 style="font-size:17px; font-weight:600; margin:0 0 4px; font-family:'IBM Plex Mono',monospace;">red</h3>
                <div style="font-size:13px; color:oklch(55% 0.01 260); margin-bottom:12px;">TypeScript / Bun</div>
                <p style="font-size:14px; color:oklch(45% 0.01 260); margin:0 0 12px;">Build Package Skills with a fast TypeScript/Bun runtime.</p>
                <span style="font-size:13px; color:oklch(55% 0.18 260); font-family:'IBM Plex Mono',monospace;">View repo →</span>
              </a>

              <a href="https://github.com/getcolors/green" style="display:block; background:oklch(97.5% 0.003 260); border:1px solid oklch(91% 0.005 260); border-radius:12px; padding:24px; color:inherit;" class="h2">
                <div style="width:32px; height:32px; border-radius:8px; background:oklch(65% 0.17 145); margin-bottom:16px;"></div>
                <h3 style="font-size:17px; font-weight:600; margin:0 0 4px; font-family:'IBM Plex Mono',monospace;">green</h3>
                <div style="font-size:13px; color:oklch(55% 0.01 260); margin-bottom:12px;">Clojure / Babashka</div>
                <p style="font-size:14px; color:oklch(45% 0.01 260); margin:0 0 12px;">Build Package Skills with Clojure over Babashka.</p>
                <span style="font-size:13px; color:oklch(55% 0.18 260); font-family:'IBM Plex Mono',monospace;">View repo →</span>
              </a>

              <a href="https://github.com/getcolors/blue" style="display:block; background:oklch(97.5% 0.003 260); border:1px solid oklch(91% 0.005 260); border-radius:12px; padding:24px; color:inherit;" class="h2">
                <div style="width:32px; height:32px; border-radius:8px; background:oklch(55% 0.18 260); margin-bottom:16px;"></div>
                <h3 style="font-size:17px; font-weight:600; margin:0 0 4px; font-family:'IBM Plex Mono',monospace;">blue</h3>
                <div style="font-size:13px; color:oklch(55% 0.01 260); margin-bottom:12px;">Python / uv</div>
                <p style="font-size:14px; color:oklch(45% 0.01 260); margin:0 0 12px;">Build Package Skills with Python, managed by uv.</p>
                <span style="font-size:13px; color:oklch(55% 0.18 260); font-family:'IBM Plex Mono',monospace;">View repo →</span>
              </a>

          </div>
        </div>
      </div>

      <!-- ONCE: EXAMPLE PACKAGE -->
      <div id="once" style="border-top:1px solid oklch(92% 0.005 260); padding:72px 24px; background:oklch(97.5% 0.003 260);">
        <div style="max-width:1120px; margin:0 auto;">
          <div style="font-family:'IBM Plex Mono',monospace; font-size:12px; color:oklch(55% 0.18 260); margin-bottom:12px;">EXAMPLE PACKAGE SKILL</div>
          <h2 style="font-size:28px; font-weight:600; letter-spacing:-0.01em; margin:0 0 12px;">Once: a personal PaaS, built with Colors</h2>
          <p style="font-size:16px; color:oklch(45% 0.01 260); margin:0 0 40px; max-width:680px;">Once is a Package Skill built with Colors. It provisions a VPS, configures DNS and outgoing mail, installs Docker, and reconciles declared applications — a self-hosted alternative to Netlify or Vercel that an agent runs end to end.</p>

          <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:48px;" class="r-4">

              <div style="position:relative;">
                <div style="border:1px solid oklch(91% 0.005 260); border-radius:10px; padding:20px; height:100%; background:oklch(99% 0.002 90);">
                  <div style="font-family:'IBM Plex Mono',monospace; font-size:11px; color:oklch(55% 0.01 260); margin-bottom:8px;">STEP 01</div>
                  <h4 style="font-size:15px; font-weight:600; margin:0 0 6px;">Read desired state</h4>
                  <p style="font-size:13px; color:oklch(45% 0.01 260); margin:0;">Agent reads colors.yml. Hostnames determine DNS zones and mail domains.</p>
                </div>
              </div>

              <div style="position:relative;">
                <div style="border:1px solid oklch(91% 0.005 260); border-radius:10px; padding:20px; height:100%; background:oklch(99% 0.002 90);">
                  <div style="font-family:'IBM Plex Mono',monospace; font-size:11px; color:oklch(55% 0.01 260); margin-bottom:8px;">STEP 02</div>
                  <h4 style="font-size:15px; font-weight:600; margin:0 0 6px;">Resolve secrets</h4>
                  <p style="font-size:13px; color:oklch(45% 0.01 260); margin:0;">Env map points to COLORS_PAR_* variables, deferred until runtime.</p>
                </div>
              </div>

              <div style="position:relative;">
                <div style="border:1px solid oklch(91% 0.005 260); border-radius:10px; padding:20px; height:100%; background:oklch(99% 0.002 90);">
                  <div style="font-family:'IBM Plex Mono',monospace; font-size:11px; color:oklch(55% 0.01 260); margin-bottom:8px;">STEP 03</div>
                  <h4 style="font-size:15px; font-weight:600; margin:0 0 6px;">Dry-run boundary</h4>
                  <p style="font-size:13px; color:oklch(45% 0.01 260); margin:0;">Builds files under .once/ and runs create --dry-run, touching nothing live.</p>
                </div>
              </div>

              <div style="position:relative;">
                <div style="border:1px solid oklch(91% 0.005 260); border-radius:10px; padding:20px; height:100%; background:oklch(99% 0.002 90);">
                  <div style="font-family:'IBM Plex Mono',monospace; font-size:11px; color:oklch(55% 0.01 260); margin-bottom:8px;">STEP 04</div>
                  <h4 style="font-size:15px; font-weight:600; margin:0 0 6px;">Provision & reconcile</h4>
                  <p style="font-size:13px; color:oklch(45% 0.01 260); margin:0;">OpenTofu provisions compute/SMTP/DNS; Ansible configures local and remote hosts.</p>
                </div>
              </div>

          </div>

          <!-- DAG diagram -->
          <div class="dag-panel" style="border:1px solid oklch(91% 0.005 260); border-radius:12px; padding:36px; background:oklch(99% 0.002 90);">
            <div style="font-family:'IBM Plex Mono',monospace; font-size:12px; color:oklch(55% 0.01 260); margin-bottom:24px;">Once — CREATE / BUILD DAG</div>
            <div class="dag" style="display:flex; align-items:center; gap:0; flex-wrap:wrap; font-family:'IBM Plex Mono',monospace; font-size:13px;">
              <div style="background:oklch(20% 0.01 260); color:white; padding:10px 16px; border-radius:8px;">start</div>
              <div class="dag-edge" style="width:32px; height:1px; background:oklch(80% 0.005 260);"></div>
              <div class="dag-group" style="display:flex; flex-direction:column; gap:8px;">
                <div style="background:white; border:1px solid oklch(85% 0.005 260); padding:10px 16px; border-radius:8px;">tofu-compute</div>
                <div style="background:white; border:1px solid oklch(85% 0.005 260); padding:10px 16px; border-radius:8px;">tofu-smtp</div>
              </div>
              <div class="dag-edge" style="width:32px; height:1px; background:oklch(80% 0.005 260);"></div>
              <div style="background:white; border:1px solid oklch(85% 0.005 260); padding:10px 16px; border-radius:8px;">tofu-dns</div>
              <div class="dag-edge" style="width:32px; height:1px; background:oklch(80% 0.005 260);"></div>
              <div style="background:white; border:1px solid oklch(85% 0.005 260); padding:10px 16px; border-radius:8px;">tofu-smtp-post</div>
              <div class="dag-edge" style="width:32px; height:1px; background:oklch(80% 0.005 260);"></div>
              <div class="dag-group" style="display:flex; flex-direction:column; gap:8px;">
                <div style="background:white; border:1px solid oklch(85% 0.005 260); padding:10px 16px; border-radius:8px;">ansible-local</div>
                <div style="background:white; border:1px solid oklch(85% 0.005 260); padding:10px 16px; border-radius:8px;">ansible-remote</div>
              </div>
            </div>
            <p style="font-size:13px; color:oklch(45% 0.01 260); margin:20px 0 0;">Delete runs cleanup, SMTP post, and DNS, then SMTP and compute in parallel. Step failures travel as namespaced exit codes, never uncaught exceptions.</p>
          </div>
        </div>
      </div>

      <!-- FINAL CTA -->
      <div style="border-top:1px solid oklch(92% 0.005 260); padding:80px 24px; text-align:center;">
        <div style="max-width:640px; margin:0 auto;">
          <h2 style="font-size:30px; font-weight:600; letter-spacing:-0.01em; margin:0 0 16px;">Give your agent a new skill to create a personal PaaS.</h2>
          <p style="font-size:16px; color:oklch(45% 0.01 260); margin:0 0 32px;">Dry-run first. Approve. Then provision — with Once, built with Colors. Paste this into your coding agent.</p>
          <div style="display:inline-flex; align-items:center; gap:10px; background:oklch(20% 0.01 260); border-radius:8px; padding:14px 20px; margin:0 auto;">
            <code style="font-family:'IBM Plex Mono',monospace; font-size:14px; color:oklch(96% 0.005 260);">npx skills use getcolors/once</code>
            <button data-copy="npx skills use getcolors/once" style="background:oklch(30% 0.01 260); color:oklch(96% 0.005 260); border:none; border-radius:6px; padding:6px 12px; font-size:12px; font-family:'IBM Plex Mono',monospace; cursor:pointer;" class="h1">Copy</button>
          </div>
        </div>
      </div>

      <!-- FOOTER -->
      <div style="border-top:1px solid oklch(92% 0.005 260); padding:28px 24px;">
        <div style="max-width:1120px; margin:0 auto; display:flex; justify-content:space-between; font-size:13px; color:oklch(55% 0.01 260);">
          <span>Colors</span>
          <a href="https://github.com/getcolors" style="color:oklch(55% 0.01 260);">GitHub</a>
        </div>
      </div>

    </div>

    <script is:inline>
      document.querySelectorAll("[data-copy]").forEach((button) => {
        button.addEventListener("click", () => {
          navigator.clipboard?.writeText(button.dataset.copy);
          button.textContent = "Copied";
          setTimeout(() => (button.textContent = "Copy"), 1500);
        });
      });
    </script>
  </body>
</html>
