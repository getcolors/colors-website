---
import { marked } from "marked";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import PocketContextArchitecture from "~/components/PocketContextArchitecture.astro";
import CatalogLayout from "~/layouts/CatalogLayout.astro";
import { postFor } from "~/data/blog";
import article from "~/data/articles/headless-is-the-feature.md?raw";

const path = "/blog/headless-is-the-feature";
const post = postFor(path);
const title = `${post.title} — Colors`;
const description = post.summary;
const image = "/og-headless-is-the-feature-v2.png";
const imageAlt = "Illustration comparing a conventional application frontend with agents accessing PocketContext through SQL reads and API operations.";
const absolute = (value: string) => new URL(value, Astro.site).toString();
const sections = article.replace(/^# .+\r?\n/, "").split("<!-- pocketcontext-architecture -->");
if (sections.length !== 2) throw new Error("Expected one PocketContext architecture marker");
const [beforeDiagram, afterDiagram] = sections.map(section => marked.parse(section, { async: false }));
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: post.title,
  description,
  url: absolute(path),
  image: absolute(image),
  datePublished: post.isoDate,
  dateModified: post.isoDate,
  author: { "@type": "Person", name: "Alberto Miorin", url: "https://www.linkedin.com/in/albertomiorin/" },
  publisher: { "@type": "Organization", name: "Colors", url: absolute("/") },
};
---

<CatalogLayout {title} {description} {path} {image} {imageAlt} type="article" active="blog">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="wrap headless-post">
    <Breadcrumbs items={[{ label: "Blog", href: "/blog" }, { label: "Headless is the feature" }]} />
    <header>
      <p class="eyebrow">PocketContext · DealContext · Architecture</p>
      <h1>{post.title}</h1>
      <p class="post-meta">{post.date} · {post.readTime} · By Alberto Miorin</p>
      <p class="lede">The coding agent is the interface. Put the work into the schema, business rules, and tests. PocketBase already has the CRUD dashboard.</p>
    </header>
    <figure class="intro-video">
      <video controls playsinline preload="none" width="1280" height="720"
        poster="/images/cards/headless-is-the-feature-v2.jpg"
        aria-label="Conventional and headless agent architectures, a ten-second animation"
        aria-describedby="headless-video-caption">
        <source src="/videos/headless-is-the-feature.mp4" type="video/mp4" />
        <a href="/videos/headless-is-the-feature.mp4">Download the architecture animation</a>.
      </video>
      <figcaption id="headless-video-caption">A ten-second illustration of conventional and agent-operated applications. The technical diagram below explains PocketContext's read and write paths.</figcaption>
    </figure>
    <article class="article-body">
      <div set:html={beforeDiagram} />
      <PocketContextArchitecture />
      <div set:html={afterDiagram} />
    </article>
  </div>
</CatalogLayout>

<style>
  .headless-post { padding-top: 2rem; padding-bottom: 5rem; }
  header { margin: 3.5rem 0 2.5rem; }
  .eyebrow { color: var(--green, #237a44); font: 500 .8rem "IBM Plex Mono", monospace; text-transform: uppercase; letter-spacing: .09em; }
  h1 { font-size: clamp(2.3rem, 6vw, 4rem); line-height: 1.08; letter-spacing: -.035em; max-width: 18ch; margin: 1rem 0; }
  .post-meta { font: .8rem "IBM Plex Mono", monospace; opacity: .65; }
  .lede { font-size: 1.3rem; line-height: 1.6; margin-top: 1.6rem; }
  .intro-video { margin: 0 0 2.5rem; }
  .intro-video video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #17191c; border-radius: 10px; }
  .intro-video figcaption { margin-top: .75rem; font-size: .85rem; line-height: 1.6; color: var(--muted); }
  .article-body { font-size: 1.06rem; line-height: 1.8; overflow-wrap: break-word; }
  .article-body :global(h2) { margin: 2.8rem 0 1rem; font-size: 1.8rem; line-height: 1.25; letter-spacing: -.025em; }
  .article-body :global(h3) { margin: 2rem 0 .7rem; font-size: 1.3rem; line-height: 1.35; }
  .article-body :global(p), .article-body :global(ul), .article-body :global(ol) { margin: 1rem 0; }
  .article-body :global(li) { margin: .4rem 0; }
  .article-body :global(a) { text-decoration: underline; text-underline-offset: .18em; }
  .article-body :global(code) { font: .86em "IBM Plex Mono", monospace; }
  .article-body :global(pre) { overflow-x: auto; padding: 1.3rem; border: 1px solid #d9ded9; border-radius: 8px; background: #f3f6f3; line-height: 1.65; margin: 1.5rem 0; }
  .article-body :global(pre code) { font-size: .79rem; white-space: pre; }
  .article-body :global(table) { display: block; overflow-x: auto; border-collapse: collapse; width: 100%; margin: 1.5rem 0; font-size: .95rem; }
  .article-body :global(th), .article-body :global(td) { padding: .7rem 1rem; border-bottom: 1px solid #d9ded9; text-align: left; vertical-align: top; }
  .article-body :global(blockquote) { margin: 1.5rem 0; border-left: 3px solid #237a44; padding: .1rem 1.2rem; }
  @media (max-width: 600px) { header { margin-top: 2.5rem; } }
</style>
