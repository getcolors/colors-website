    font-size: 15.5px;
    line-height: 1.7;
    color: var(--ink);
    padding-left: 24px;
    margin: 0 0 24px;
  }
  .content-body li {
    margin-bottom: 8px;
  }
  .table-wrap {
    overflow-x: auto;
    margin: 28px 0;
    padding: 0;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    line-height: 1.5;
  }
  .data-table th {
    background: var(--surface);
    padding: 12px 16px;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12px;
  }
