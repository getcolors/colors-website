---
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import CatalogLayout from "~/layouts/CatalogLayout.astro";

const title = "Blog — Colors";
const description = "Technical articles, empirical benchmarks, and architectural deep-dives into Agentic DevOps and the Colors SDK.";
const path = "/blog";

const articles = [
  {
    title: "Benchmarking Gemini 3.7 Flash on Autonomous Distributed Infrastructure: Building PostgreSQL & MySQL HA Clusters from Scratch",
    slug: "/blog/gemini-3-7-flash-benchmark",
    date: "August 16, 2026",
    readTime: "7 min read",
    category: "Benchmark",
    runtime: "Gemini 3.7 Flash",
    summary: "An empirical creation-effort benchmark evaluating Gemini 3.7 Flash building and deploying 3-node PostgreSQL and MySQL High Availability clusters to DigitalOcean with continuous backups to Cloudflare R2.",
    image: "/images/benchmark_setup_flow_1786877790896.jpg",
    tags: ["Benchmark", "Gemini 3.7", "PostgreSQL HA", "MySQL HA", "DigitalOcean", "Cloudflare R2"],
  },
];
---

<CatalogLayout {title} {description} {path} active="blog">
  <div class="wrap blog-page">
    <div class="breadcrumb-bar">
      <Breadcrumbs items={[{ label: "Blog" }]} />
    </div>

    <header class="blog-header">
      <p class="section-label">Research & Technical Articles</p>
      <h1>Engineering Blog</h1>
      <p class="lede">Empirical benchmarks, architecture deep-dives, and research on autonomous infrastructure engineering with the Colors SDK.</p>
    </header>

    <div class="articles-grid">
      {articles.map((post) => (
        <article class="post-card panel">
          <a href={post.slug} class="post-media">
            <img src={post.image} alt={post.title} loading="lazy" />
          </a>
          <div class="post-body">
            <div class="post-meta">
              <span class="runtime runtime-blue">{post.runtime}</span>
              <span class="post-date mono">{post.date}</span>
              <span class="dot">·</span>
              <span class="post-readtime mono">{post.readTime}</span>
            </div>
            <h2 class="post-title">
              <a href={post.slug}>{post.title}</a>
            </h2>
            <p class="post-summary">{post.summary}</p>
            <div class="post-footer">
              <div class="tag-list">
                {post.tags.map((tag) => <span class="tag-item mono">#{tag}</span>)}
              </div>
              <a href={post.slug} class="button-link">Read article →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</CatalogLayout>

<style>
  .blog-page {
    padding-block: 24px 80px;
  }
  .breadcrumb-bar {
    margin-bottom: 24px;
  }
  .blog-header {
    margin-bottom: 48px;
  }
  .articles-grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .post-card {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 32px;
    padding: 24px;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .post-card:hover {
    border-color: var(--blue);
    box-shadow: 0 10px 30px oklch(20% 0.01 260 / 6%);
  }
  .post-media {
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    display: block;
    aspect-ratio: 16 / 9;
  }
  .post-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 240ms ease;
  }
  .post-card:hover .post-media img {
    transform: scale(1.02);
  }
  .post-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    font-size: 12px;
    color: var(--muted);
    line-height: 1;
  }
  .post-date, .post-readtime {
    line-height: 1;
  }
  .dot {
    color: var(--rule);
    font-size: 14px;
    line-height: 1;
  }
  .post-title {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .post-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .post-title a:hover {
    color: var(--blue);
  }
  .post-summary {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 20px;
  }
  .post-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag-item {
    font-size: 12px;
    color: var(--soft);
  }
  @media (max-width: 860px) {
    .post-card {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 16px;
    }
  }
</style>
