---
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import CatalogLayout from "~/layouts/CatalogLayout.astro";
import { posts } from "~/data/blog";

const title = "Blog — Colors";
const description = "Technical articles, empirical benchmarks, and architectural deep-dives into Agentic DevOps and the Colors SDK.";
const path = "/blog";

// The article list lives in src/data/blog.ts so the feed and the sitemap
// cannot drift from what this page shows.
const articles = posts;
---

<CatalogLayout {title} {description} {path} active="blog">
  <div class="wrap blog-page">
    <div class="breadcrumb-bar">
      <Breadcrumbs items={[{ label: "Blog" }]} />
    </div>

    <header class="blog-header">
      <p class="section-label">Research & Technical Articles</p>
      <h1>Engineering Blog</h1>
      <p class="lede">Empirical benchmarks, architecture deep-dives, and research on autonomous infrastructure engineering with the Colors SDK.</p>
    </header>

    <div class="articles-grid">
      {articles.map((post) => (
        <a href={post.slug} class="post-card panel">
          <div class="post-media">
            <img src={post.image} alt={post.title} />
          </div>
          <div class="post-body">
            <div>
              <div class="post-meta">
                <span class="runtime runtime-blue">{post.runtime}</span>
                <span class="post-date mono">{post.date}</span>
                <span class="dot">·</span>
                <span class="post-readtime mono">{post.readTime}</span>
              </div>
              <h2 class="post-title">{post.title}</h2>
              <p class="post-summary">{post.summary}</p>
            </div>
            <div class="tag-list">
              {post.tags.map((tag) => <span class="tag-item mono">#{tag}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</CatalogLayout>

<style>
  .blog-page {
    padding-block: 24px 80px;
  }
  .breadcrumb-bar {
    margin-bottom: 24px;
  }
  .blog-header {
    margin-bottom: 48px;
  }
  .articles-grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .post-card {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 32px;
    padding: 24px;
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }
  .post-card:hover {
    border-color: var(--blue);
    box-shadow: 0 10px 30px oklch(20% 0.01 260 / 6%);
    transform: translateY(-2px);
  }
  .post-card:hover .post-title {
    color: var(--blue);
  }
  .post-media {
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    display: block;
    aspect-ratio: 16 / 9;
  }
  .post-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 240ms ease;
  }
  .post-card:hover .post-media img {
    transform: scale(1.02);
  }
  .post-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 12px;
    color: var(--muted);
    line-height: 1;
  }
  .post-date, .post-readtime {
    line-height: 1;
  }
  .dot {
    color: var(--rule);
    font-size: 14px;
    line-height: 1;
  }
  .post-title {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
    transition: color 160ms ease;
  }
  .post-summary {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 18px;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }
  .tag-item {
    font-size: 12px;
    color: var(--soft);
  }
  @media (max-width: 860px) {
    .post-card {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 16px;
    }
  }
</style>
