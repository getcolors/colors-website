---
import { footer } from "~/data/landing";
---

<footer class="foot">
  <div class="foot-inner">
    <a class="footer-home" href="/" aria-label="Colors — home">
      <img src="/favicon.svg" width="20" height="20" alt="" />
      <span>{footer.name}</span>
    </a>
    <div class="footer-links">
      {footer.links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
      ))}
    </div>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--rule); padding: 28px 0; }
  .foot-inner { box-sizing: border-box; max-width: 1120px; margin: 0 auto; padding-inline: 24px; display: flex; align-items: center; justify-content: space-between; font-size: 13px; color: var(--soft); }
  .foot a { color: var(--soft); text-decoration: none; }
  .foot a:hover { color: var(--blue); }
  .footer-home { display: inline-flex; align-items: center; gap: 10px; }
  .footer-links { display: flex; align-items: center; gap: 20px; }
  .footer-home img { border-radius: 4px; }
</style>
