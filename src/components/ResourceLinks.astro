---
interface Props {
  /** Optional: some Package Skills have no GitHub Pages site yet, and a
      "View docs" link to a 404 is worse than no link at all. */
  docsUrl?: string;
  repoUrl: string;
  catalogUrl?: string;
  card?: boolean;
}

const { docsUrl, repoUrl, catalogUrl, card = false } = Astro.props;
---

<div class:list={["resource-links", card && "resource-links-card"]}>
  {docsUrl && (
    <a href={docsUrl} target="_blank" rel="noopener noreferrer">
      <svg class="docs-icon" aria-hidden="true" viewBox="0 0 24 24">
        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11a2 2 0 0 1 2 2v16a2 2 0 0 0-2-2H6.5A2.5 2.5 0 0 0 4 21.5v-16Z" />
        <path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H13v18a2 2 0 0 1 2-2h2.5a2.5 2.5 0 0 1 2.5 2.5v-16Z" />
      </svg>
      <span>View docs</span>
    </a>
  )}
  <a href={repoUrl} target="_blank" rel="noopener noreferrer">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
    </svg>
    <span>View on GitHub</span>
  </a>
  {catalogUrl && (
    <a href={catalogUrl}>
      <svg class="docs-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m8 5 7 7-7 7" /></svg>
      <span>View in Catalog</span>
    </a>
  )}
</div>

<style>
  .resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 12px;
  }
  .resource-links-card { margin-top: auto; }
  a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    padding: 7px 11px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--page);
    color: var(--blue);
    text-decoration: none;
    transition: border-color 150ms ease, background-color 150ms ease;
  }
  a:hover {
    border-color: oklch(80% 0.04 260);
    background: oklch(97% 0.015 260);
    color: oklch(45% 0.18 260);
  }
  a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
  svg { width: 15px; height: 15px; flex: none; }
  .docs-icon {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }
</style>
