---
import { announcement, nav } from "~/data/landing";

interface Props {
  active?: "featured" | "catalog" | "blog";
}

const { active } = Astro.props;
const isCurrent = (href: string) =>
  (active === "featured" && href === "/featured") ||
  (active === "catalog" && href === "/skills") ||
  (active === "blog" && href === "/blog");

// The strip is evaluated at build time: a deploy after `until` renders no
// strip. It is not a substitute for removing the entry from landing.ts.
const showAnnouncement = Date.now() < Date.parse(announcement.until);
---

{showAnnouncement && (
  <div class="announcement" role="region" aria-label="Announcement">
    <a class="announcement-inner" href={announcement.href}>
      <span class="announcement-date">{announcement.date}</span>
      <span class="announcement-title">{announcement.title}</span>
      <span class="announcement-cta">{announcement.cta} →</span>
    </a>
  </div>
)}

<header class="site-header" data-site-header>
  <div class="nav">
    <a class="brand" href="/" aria-label="Colors — home">
      <img class="mark" src="/favicon.svg" width="20" height="20" alt="" />
      <span class="brand-name">Colors</span>
    </a>
    <nav class="nav-links" id="site-navigation" aria-label="Main navigation">
      {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  let headerUpdatePending = false;

  const updateHeader = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
    headerUpdatePending = false;
  };
  updateHeader();
  window.addEventListener("scroll", () => {
    if (headerUpdatePending) return;
    headerUpdatePending = true;
    requestAnimationFrame(updateHeader);
  }, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    background: oklch(99% 0.002 90 / 0%);
    transition: background-color 240ms ease, border-color 240ms ease, box-shadow 240ms ease, backdrop-filter 240ms ease;
  }
  .site-header.is-scrolled {
    border-color: oklch(91% 0.005 260 / 75%);
    background: oklch(99% 0.002 90 / 82%);
    box-shadow: 0 10px 30px oklch(20% 0.01 260 / 7%);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1120px;
    margin: 0 auto;
    padding: 28px 24px;
    transition: padding 240ms ease;
  }
  .site-header.is-scrolled .nav { padding-block: 14px; }
  .brand { display: flex; align-items: center; gap: 10px; color: black; text-decoration: none; }
  .brand:hover { color: black; }
  .mark { width: 20px; height: 20px; border-radius: 4px; }
  .brand-name { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .nav-links { display: flex; align-items: center; gap: 28px; color: var(--muted); font-size: 14px; }
  .nav-links a { position: relative; color: var(--muted); text-decoration: none; }
  .nav-links a:hover { color: var(--blue); }
  .nav-links a[aria-current="page"] { color: var(--blue); font-weight: 400; }
  .nav-links a:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  /* The strip is a line of the page, not a banner: page-coloured, one
     hairline under it, the date set as a mono value in the yaml green the
     hero uses for values. Only the call to action is blue. */
  .announcement { background: var(--surface, oklch(97.5% 0.003 260)); border-bottom: 1px solid var(--line, oklch(91% 0.005 260)); font-size: 13.5px; color: var(--ink, oklch(20% 0.01 260)); }
  .announcement-inner { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 20px; max-width: 1120px; margin: 0 auto; padding: 10px 24px; color: inherit; text-decoration: none; }
  .announcement-date { font-family: var(--mono); font-size: 12px; letter-spacing: 0.01em; color: oklch(45% 0.13 145); white-space: nowrap; }
  .announcement-title { flex: 1 1 auto; min-width: 0; }
  .announcement-cta { font-family: var(--mono); font-size: 12px; white-space: nowrap; color: var(--blue, oklch(55% 0.18 260)); }
  /* Hover follows the site's link convention — colour, never underline: the
     call to action darkens like every body link, and the title turns blue so
     the whole band visibly answers, since the whole band is the link. */
  .announcement-title, .announcement-cta { transition: color 150ms ease; }
  .announcement-inner:hover .announcement-cta { color: oklch(45% 0.18 260); }
  .announcement-inner:hover .announcement-title { color: var(--blue, oklch(55% 0.18 260)); }
  .announcement-inner:focus-visible { outline: 2px solid var(--blue, oklch(55% 0.18 260)); outline-offset: -3px; }
  @media (max-width: 860px) {
    .nav { gap: 20px; padding-block: 20px; }
    .site-header.is-scrolled .nav { padding-block: 12px; }
    .nav-links { gap: 16px; font-size: 13px; }
    .announcement-inner { padding-block: 8px; gap: 2px 12px; }
    .announcement-title { flex-basis: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .site-header, .nav, .announcement-title, .announcement-cta { transition: none; } }
</style>
