---
import { nav } from "~/data/landing";

interface Props {
  active?: "featured" | "catalog" | "blog" | "slides";
}

const { active } = Astro.props;
const isCurrent = (href: string) =>
  (active === "featured" && href === "/featured") ||
  (active === "catalog" && href === "/skills") ||
  (active === "blog" && href === "/blog") ||
  (active === "slides" && href === "/slides");

---

<header class="site-header" data-site-header>
  <div class="nav">
    <a class="brand" href="/" aria-label="Colors — home">
      <img class="mark" src="/favicon.svg" width="20" height="20" alt="" />
      <span class="brand-name">Colors</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Open navigation" data-nav-toggle>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path class="menu-icon" d="M4 6h16M4 12h16M4 18h16" />
        <path class="close-icon" d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
    <nav class="nav-links" id="site-navigation" aria-label="Main navigation">
      {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  let headerUpdatePending = false;

  const updateHeader = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
    headerUpdatePending = false;
  };
  updateHeader();
  window.addEventListener("scroll", () => {
    if (headerUpdatePending) return;
    headerUpdatePending = true;
    requestAnimationFrame(updateHeader);
  }, { passive: true });

  const toggle = header?.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const navigation = header?.querySelector<HTMLElement>("#site-navigation");
  const mobileViewport = window.matchMedia("(max-width: 600px)");

  if (header && toggle && navigation) {
    const setMenuOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
      header.classList.toggle("menu-open", open);
    };

    toggle.addEventListener("click", () => {
      setMenuOpen(toggle.getAttribute("aria-expanded") !== "true");
    });
    navigation.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) setMenuOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setMenuOpen(false);
        toggle.focus();
      }
    });
    mobileViewport.addEventListener("change", () => {
      const focusWasInNavigation = navigation.contains(document.activeElement);
      const focusWasOnToggle = document.activeElement === toggle;
      setMenuOpen(false);
      if (mobileViewport.matches && focusWasInNavigation) toggle.focus();
      if (!mobileViewport.matches && focusWasOnToggle) navigation.querySelector<HTMLAnchorElement>("a")?.focus();
    });
    header.classList.add("nav-enhanced");
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    background: oklch(99% 0.002 90 / 0%);
    transition: background-color 240ms ease, border-color 240ms ease, box-shadow 240ms ease, backdrop-filter 240ms ease;
  }
  .site-header.is-scrolled {
    border-color: oklch(91% 0.005 260 / 75%);
    background: oklch(99% 0.002 90 / 82%);
    box-shadow: 0 10px 30px oklch(20% 0.01 260 / 7%);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1120px;
    margin: 0 auto;
    padding: 28px 24px;
    transition: padding 240ms ease;
  }
  .site-header.is-scrolled .nav { padding-block: 14px; }
  .brand { display: flex; align-items: center; gap: 10px; color: black; text-decoration: none; }
  .brand:hover { color: black; }
  .mark { width: 20px; height: 20px; border-radius: 4px; }
  .brand-name { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .nav-links { display: flex; align-items: center; gap: 28px; color: var(--muted); font-size: 14px; }
  .nav-links a { position: relative; color: var(--muted); text-decoration: none; }
  .nav-links a:hover { color: var(--blue); }
  .nav-links a[aria-current="page"] { color: var(--blue); font-weight: 400; }
  .nav-links a:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  .nav-toggle { display: none; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 1px solid var(--line, oklch(91% 0.005 260)); border-radius: 8px; background: transparent; color: var(--ink, oklch(20% 0.01 260)); cursor: pointer; }
  .nav-toggle:hover { color: var(--blue); background: var(--surface, oklch(97.5% 0.003 260)); }
  .nav-toggle:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  .close-icon { display: none; }
  .menu-open .menu-icon { display: none; }
  .menu-open .close-icon { display: block; }
  @media (max-width: 860px) {
    .nav { gap: 20px; padding-block: 20px; }
    .site-header.is-scrolled .nav { padding-block: 12px; }
    .nav-links { gap: 16px; font-size: 13px; }
  }
  @media (max-width: 600px) {
    .nav { flex-wrap: wrap; gap: 12px; padding-block: 12px; }
    .site-header.is-scrolled .nav { padding-block: 8px; }
    .nav-links { width: 100%; flex-wrap: wrap; justify-content: space-between; gap: 8px 12px; }
    .nav-links a { display: flex; align-items: center; min-height: 44px; }
    .nav-enhanced .nav-toggle { display: flex; }
    .nav-enhanced .nav-links { display: none; }
    .nav-enhanced.menu-open { border-color: var(--line, oklch(91% 0.005 260)); background: oklch(99% 0.002 90); }
    .nav-enhanced.menu-open .nav-links { display: flex; flex-direction: column; align-items: stretch; gap: 0; padding-top: 8px; border-top: 1px solid var(--line, oklch(91% 0.005 260)); }
    .nav-enhanced.menu-open .nav-links a { padding-inline: 4px; }
  }
  @media (prefers-reduced-motion: reduce) { .site-header, .nav { transition: none; } }
</style>
