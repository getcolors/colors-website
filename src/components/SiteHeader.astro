---
import { nav } from "~/data/landing";

interface Props {
  active?: "featured" | "catalog" | "blog";
}

const { active } = Astro.props;
const isCurrent = (href: string) =>
  (active === "featured" && href === "/featured") ||
  (active === "catalog" && href === "/skills") ||
  (active === "blog" && href === "/blog");
---

<header class="site-header" data-site-header>
  <div class="nav">
    <a class="brand" href="/" aria-label="Colors — home">
      <img class="mark" src="/favicon.svg" width="20" height="20" alt="" />
      <span class="brand-name">Colors</span>
    </a>
    <nav class="nav-links" id="site-navigation" aria-label="Main navigation">
      {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  let headerUpdatePending = false;

  const updateHeader = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
    headerUpdatePending = false;
  };
  updateHeader();
  window.addEventListener("scroll", () => {
    if (headerUpdatePending) return;
    headerUpdatePending = true;
    requestAnimationFrame(updateHeader);
  }, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    background: oklch(99% 0.002 90 / 0%);
    transition: background-color 240ms ease, border-color 240ms ease, box-shadow 240ms ease, backdrop-filter 240ms ease;
  }
  .site-header.is-scrolled {
    border-color: oklch(91% 0.005 260 / 75%);
    background: oklch(99% 0.002 90 / 82%);
    box-shadow: 0 10px 30px oklch(20% 0.01 260 / 7%);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1120px;
    margin: 0 auto;
    padding: 28px 24px;
    transition: padding 240ms ease;
  }
  .site-header.is-scrolled .nav { padding-block: 14px; }
  .brand { display: flex; align-items: center; gap: 10px; color: black; text-decoration: none; }
  .brand:hover { color: black; }
  .mark { width: 20px; height: 20px; border-radius: 4px; }
  .brand-name { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .nav-links { display: flex; align-items: center; gap: 28px; color: var(--muted); font-size: 14px; }
  .nav-links a { position: relative; color: var(--muted); text-decoration: none; }
  .nav-links a:hover { color: var(--blue); }
  .nav-links a[aria-current="page"] { color: var(--blue); font-weight: 400; }
  .nav-links a:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  @media (max-width: 860px) {
    .nav { gap: 20px; padding-block: 20px; }
    .site-header.is-scrolled .nav { padding-block: 12px; }
    .nav-links { gap: 16px; font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .site-header, .nav { transition: none; } }
</style>
